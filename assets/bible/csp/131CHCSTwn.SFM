\id 1CH
\c 1
\s1 Rodopis od Adama k~Abrahamovi
\p
\v 1 Adam, Šét, Enóš,
\v 2 Kénan, Mahalalel, Jered,
\v 3 Henoch, Metúšelach, Lámech,
\v 4 Noe, Šém, Chám a~Jefet.
\p
\v 5 Synové Jefetovi: Gomer, Magóg, Mádaj, Jávan, Túbal, Mešek a~Tíras.
\p
\v 6 Synové Gomerovi: Aškenaz, Rífat a~Togarma.
\v 7 Synové Jávanovi: Elíša, Taršíš, Kitejci a~Dódanci.
\v 8 Synové Chámovi: Kúš, Misrajim, Pút a~Kenaan.
\v 9 Synové Kúšovi: Seba, Chavíla, Sabta, Raema a~Sabteka. Synové Raemovi: Šeba a~Dedán.
\p
\v 10 Kúš zplodil Nimroda. Ten se stal prvním hrdinou na zemi.
\p
\v 11 Misrajim zplodil Lúďany, Anámce, Lehábany, Naftúchany,
\v 12 Patrúsany, Kaslúchany (z~nich vzešli Pelištejci) a~Kaftórce.
\p
\v 13 Kenaan zplodil Sidóna, svého prvorozeného, a~Chéta,
\v 14 Jebúsejce, Emorejce, Girgašejce,
\v 15 Chivejce, Arkejce, Sínejce,
\v 16 Arvádejce, Semárejce a~Chamátejce.
\p
\v 17 Synové Šémovi: Élam, Ašúr, Arpakšád, Lúd, Aram, Ús, Chúl, Geter a~Mešek.
\p
\v 18 Arpakšád zplodil Šelacha, Šelach zplodil Hebera.
\v 19 Heberovi se narodili dva synové: První se jmenoval Peleg (protože v~jeho dnech byla rozdělena země) a~jeho bratr se jmenoval Joktán.
\v 20 Joktán zplodil Almódada, Šelefa, Chasarmáveta, Jeracha,
\v 21 Hadoráma, Úzala, Diklu,
\v 22 Ébala, Abímaela, Šebu,
\v 23 Ofíra, Chavílu a~Jóbaba. Ti všichni \it jsou\it* synové Joktánovi.
\p
\v 24 Šém, Arpakšád, Šelach,
\v 25 Heber, Peleg, Reú,
\v 26 Serúg, Náchor, Terach,
\v 27 Abram, \it to\it* je Abraham.
\s1 Potomci Abrahamovi
\p
\v 28 Synové Abrahamovi: Izák a~Izmael.
\p
\v 29 Toto \it je\it* jejich rodopis: Izmaelův prvorozený Nebajót, Kédar, Adbeel, Mibsám,
\v 30 Mišma, Dúma, Masa, Chadad, Téma,
\v 31 Jetúr, Náfiš a~Kedma. Toto jsou synové Izmaelovi.
\p
\v 32 Synové Ketúry, Abrahamovy konkubíny: Porodila Zimrána, Jokšána, Medána, Midjána, Jišbaka a~Šúacha. Synové Jokšánovi: Šeba a~Dedán.
\p
\v 33 Synové Midjánovi: Éfa, Éfer, Chanók, Abída a~Eldáa. Ti všichni \it jsou\it* synové Ketúry.
\p
\v 34 Abraham zplodil Izáka. Synové Izákovi: Ezau a~Izrael.
\s1 Potomci Ezauovi
\p
\v 35 Synové Ezauovi: Elífaz, Reúel, Jeúš, Jaelam a~Kórach.
\v 36 Synové Elífazovi: Téman, Ómar, Sefí, Gátam, Kenaz, Timna a~Amálek.
\p
\v 37 Synové Reúelovi: Nachat, Zerach, Šama a~Miza.
\p
\v 38 Synové Seírovi: Lótan, Šóbal, Sibeón, Ana, Díšon, Eser a~Díšan.
\v 39 Synové Lótanovi: Chorí a~Hómam. Lótanova sestra: Timna.
\p
\v 40 Synové Šóbalovi: Alján, Manachat, Ébal, Šefí a~Ónam. Synové Sibeónovi: Aja a~Ana.
\v 41 Synové Anovi: Díšon. Synové Díšonovi: Chamrán, Ešbán, Jitrán a~Keran.
\p
\v 42 Synové Eserovi: Bilhán, Zaavan \it a\it*~Jaakan. Synové Díšonovi: Ús a~Aran.
\s1 Vládci Edómu
\p
\v 43 Toto \it jsou\it* králové, kteří kralovali v~edómské zemi, dříve než se \it kdo\it* stal králem nad syny Izraele: Bela, syn Beórův; jeho město se jmenovalo Dinhaba.
\v 44 Když Bela zemřel, stal se po něm králem Jóbab, syn Zerachův, z~Bosry.
\v 45 Když Jóbab zemřel, stal se po něm králem Chúšam z~témanské země.
\v 46 Když Chúšam zemřel, stal se po něm králem Hadad, syn Bedadův, který pobil Midjánce na moábském poli. Jeho město se jmenovalo Avít.
\v 47 Když Hadad zemřel, stal se po něm králem Samla z~Masreky.
\v 48 Když Samla zemřel, stal se po něm králem Šaúl z~Rechobótu na řece.
\v 49 Když zemřel Šaúl, stal se po něm králem Baal‑chanan, syn Akbórův.
\v 50 Když Baal‑chanan zemřel, stal se po něm králem Hadad. Jeho město se jmenovalo Paí a~jeho žena se jmenovala Mehétabel, dcera Matredy, dcera Mezahabova.
\v 51 Pak zemřel Hadad. Edómskými náčelníky se stali náčelník Timna, náčelník Alva, náčelník Jetet,
\v 52 náčelník Oholíbama, náčelník Éla, náčelník Pínon,
\v 53 náčelník Kenaz, náčelník Téman, náčelník Mibsár,
\v 54 náčelník Magdíel \it a\it*~náčelník Íram. To \it byli\it* edómští náčelníci.
\c 2
\s1 Synové Izraelovi
\p
\v 1 Toto \it jsou\it* synové Izraelovi: Rúben, Šimeón, Lévi, Juda, Isachar, Zabulón,
\v 2 Dan, Josef, Benjamín, Neftalí, Gád a~Ašer.
\p
\v 3 Synové Judovi: Ér, Ónan, Šéla, tři, \it kteří\it* se mu narodili z~dcery Šúovy, Kenaanky. Ér, Judův prvorozený, byl v~Hospodinových očích zlý a~\it Hospodin\it* ho usmrtil.
\p
\v 4 Jeho snacha Támar mu porodila Peresa a~Zeracha. Všech Judových synů \it bylo\it* pět.
\p
\v 5 Synové Peresovi: Chesrón a~Chámul.
\p
\v 6 Synové Zerachovi: Zimrí, Étan, Héman, Kalkol, Dára, celkem pět.
\p
\v 7 Synové Karmího: Akár, který \it na\it* Izrael přivedl zkázu, protože se zpronevěřil \it věrolomností\it* při klatbě.
\p
\v 8 Syn Étanův: Azarjáš.
\p
\v 9 Synové Chesrónovi, kteří se mu narodili: Jerachmeel, Rám a~Kelúbaj.
\p
\v 10 Rám zplodil Amínadaba, Amínadab zplodil Nachšóna, předáka synů Judových.
\v 11 Nachšón zplodil Salmu, Salma zplodil Bóaza,
\v 12 Bóaz zplodil Obéda, Obéd zplodil Jišaje,
\v 13 Jišaj zplodil svého prvorozeného Elíaba, druhého Abínádaba, třetího Šimeu,
\v 14 čtvrtého Netanela, pátého Radaje,
\v 15 šestého Osema \it a\it*~sedmého Davida.
\v 16 Jejich sestry \it byly\it* Serúja a~Abígajil. Synové Serújini: Abíšaj, Jóab, Asáel.
\v 17 Abígajil porodila Amasu; Amasův otec \it byl\it* Izmaelita Jeter.
\p
\v 18 Káleb, syn Chesrónův, zplodil \it děti\it* se \it svojí\it* ženou Azúbou a~s~Jeriótou. Toto \it jsou\it* její synové: Ješer, Šóbab a~Ardón.
\v 19 Když Azúba zemřela, Káleb si vzal Efratu. Ta mu porodila Chúra.
\v 20 Chúr zplodil Urího, Urí zplodil Besaleela.
\p
\v 21 Potom vešel Chesrón k~dceři Makíra, otce Gileádova. Vzal si ji, když mu bylo šedesát let. Porodila mu Segúba.
\v 22 Segúb zplodil Jaíra. Tomu patřilo dvacet tři měst v~gileádské zemi.
\v 23 Gešúr a~Aram jim však vzali Jaírovy vesnice, Kenat a~jeho vesnice, šedesát měst. Všichni tito \it jsou\it* synové Makíra, otce Gileádova.
\v 24 Potom Chesrón v~Káleb‑Efratě zemřel, Chesrónova žena Abija mu porodila Ašchúra, otce Tekóova.
\p
\v 25 Synové Jerachmeela, Chesrónova prvorozeného, byli: prvorozený Rám, Búna, Oren, Osem \it a\it*~Achijáš.
\v 26 Jerachmeel měl \it ještě\it* další ženu jménem Atára. \it Ta\it* byla matkou Ónama.
\p
\v 27 Synové Ráma, Jerachmeelova prvorozeného, byli: Maas, Jamín a~Eker.
\v 28 Synové Ónamovi byli: Šamaj a~Jáda. Synové Šamajovi: Nádab a~Abíšúr.
\v 29 Abíšúrova žena se jmenovala Abíchajil. Porodila mu Achbána a~Molída.
\v 30 Synové Nádabovi: Seled a~Apajim. Seled zemřel bezdětný.
\p
\v 31 Synové Apajimovi: Jiší. Synové Jišího: Šešan. Synové Šešanovi: Achláj.
\v 32 Synové Jády, Šamajova bratra: Jeter a~Jónatan. Jeter zemřel bezdětný.
\p
\v 33 Synové Jónatanovi: Pelet a~Záza. Toto byli synové Jerachmeelovi.
\v 34 Šešan neměl syny, jenom dcery. Šešan měl egyptského otroka jménem Jarcha.
\v 35 Šešan tedy dal svou dceru svému otroku Jarchovi za ženu; porodila mu Ataje.
\v 36 Ataj zplodil Nátana, Nátan zplodil Zábada,
\v 37 Zábad zplodil Eflála, Eflál zplodil Obéda,
\v 38 Obéd zplodil Jehúa, Jehú zplodil Azarjáše,
\v 39 Azarjáš zplodil Chelese, Cheles zplodil Eleásu,
\v 40 Eleása zplodil Sismaje, Sismaj zplodil Šalúma,
\v 41 Šalúm zplodil Jekamjáše a~Jekamjáš zplodil Elíšamu.
\p
\v 42 Synové Káleba, bratra Jerachmeelova: Méša, jeho prvorozený, byl otcem Zífa; synové Maréši, otce Chebrónova.
\v 43 Synové Chebrónovi: Kórach, Tapúach, Rekem a~Šema.
\v 44 Šema zplodil Rachama, otce Jorkoámova, Rekem zplodil Šamaje.
\v 45 Syn Šamajův: Maón; Maón \it byl\it* otcem Bét‑súrovým.
\v 46 Kálebova konkubína Éfa porodila Chárana, Mósu a~Gázeza. Cháran zplodil Gázeza.
\p
\v 47 Synové Johdajovi: Regem, Jótam, Géšan, Pelet, Éfa a~Šaaf.
\v 48 Kálebova konkubína Maaka porodila Šebera a~Tirchanu.
\v 49 Porodila také Šaafa, otce Madmanova, Ševu, otce Makbenova a~otce Gibeova. Kálebova dcera \it byla\it* Aksa.
\p
\v 50 Toto byli synové Kálebovi.
\p Synové Chúra, prvorozeného Efraty: Šóbal, otec Kirjat‑jearímův,
\v 51 Salma, otec Bét‑lechemův, Cháref, otec Bét‑gáderův.
\v 52 Synové Šóbala, otce Kirjat‑jearímova, byli: Haróe, polovina Menúchoťanů.
\v 53 Čeledi Kirjat‑jearíma: Jitrejci, Pútejci, Šumatejci, Mišraejci, z~nichž vzešli Soreatejci a~Eštaólci.
\p
\v 54 Synové Salmovi: Bét‑lechem, Netófajci, Atrót‑bét‑jóab, polovina Manachaťanů \it a\it*~Sorejci.
\v 55 Čeledi písařů, kteří bydleli \it v\it*~Jaebesu: Tireaťané, Šimeaťané, Súkaťané; \it to\it* jsou Kénijci, pocházející z~Chamáta, otce domu Rekábova.
\c 3
\s1 Synové Davidovi
\p
\v 1 Toto jsou synové Davidovi, kteří se mu narodili v~Chebrónu: Prvorozený Amnón s~Achínoamou Jizreelskou, druhý Daniel s~Abígajilou Karmelskou,
\v 2 třetí Abšalóm, syn Maaky, dcery gešúrského krále Talmaje, čtvrtý Adónijáš, syn Chagíty,
\v 3 pátý Šefatjáš s~Abítalou, šestý Jitreám s~jeho ženou Eglou.
\v 4 \it Těchto\it* šest se mu narodilo v~Chebrónu. Kraloval tam sedm let a~šest měsíců. V~Jeruzalémě kraloval třicet tři let.
\p
\v 5 A tito se mu narodili v~Jeruzalémě: Šimea, Šóbab, Nátan, Šalomoun – čtyři s~Batšebou, dcerou Amíelovou,
\v 6 Jibchár, Elíšama, Elífelet,
\v 7 Nógah, Nefeg, Jafía,
\v 8 Elíšama, Eljáda a~Elífelet \it – těchto\it* devět.
\v 9 \it Tito\it* všichni \it jsou\it* synové Davidovi kromě synů konkubín. Támar \it byla\it* jejich sestra.
\p
\v 10 Syn Šalomounův \it byl\it* Rechabeám \it a\it*~jeho syn Abijáš, jeho syn Ása, jeho syn Jóšafat,
\v 11 jeho syn Jóram, jeho syn Achazjáš, jeho syn Jóaš,
\v 12 jeho syn Amasjáš, jeho syn Azarjáš, jeho syn Jótam,
\v 13 jeho syn Achaz, jeho syn Chizkijáš, jeho syn Menaše,
\v 14 jeho syn Amón, jeho syn Jóšijáš.
\v 15 Synové Jóšijášovi: prvorozený Jóchanan, druhý Jójakím, třetí Sidkijáš, čtvrtý Šalúm.
\v 16 Synové Jójakímovi: jeho syn Jekonjáš \it a\it*~jeho syn Sidkijáš.
\v 17 Synové Jekonjáše, vězně: jeho syn Šealtíel,
\v 18 Malkíram, Pedajáš, Šenasar, Jekamjáš, Hóšama a~Nedabjáš.
\v 19 Synové Pedajášovi: Zerubábel a~Šimeí. Synové Zerubábelovi: Mešulámi a~Chananjáš a~jejich sestra Šelomít,
\v 20 potom Chašuba, Óhel, Berekjáš, Chasadjáš \it a\it*~Júšab‑chesed – \it těchto\it* pět.
\v 21 Synové Chananjášovi: Pelatjáš a~Ješajáš, synové Refajášovi, synové Arnánovi, synové Obadjášovi, synové Šekanjášovi.
\v 22 Synové Šekanjášovi: Šemajáš. Synové Šemajášovi: Chatúš, Jigál, Baríach, Nearjáš a~Šafat – \it těchto\it* šest.
\v 23 Synové Nearjášovi: Eljóenaj, Chizkijáš a~Azríkam – \it tito\it* tři.
\v 24 Synové Eljóenajovi: Hódavjáš, Eljašíb, Pelajáš, Akúb, Jóchanan, Delajáš a~Ananí – \it těchto\it* sedm.
\c 4
\s1 Synové Judovi
\p
\v 1 Synové Judovi: Peres, Chesrón, Karmí, Chúr a~Šóbal.
\v 2 Reajáš, syn Šóbalův, zplodil Jachata, Jachat zplodil Achúmaje a~Lahada. To \it jsou\it* čeledi soreatejské.
\p
\v 3 Toto \it jsou\it* synové Étama: Jizreel, Jišma a~Jidbáš; jejich sestra se jmenovala Haslelponí.
\v 4 Penúel \it byl\it* otec Gedórův a~Ezer otec Chušův. Toto \it jsou\it* synové Chúra, prvorozeného Efraty, otce Bét‑lechemova.
\v 5 Ašchúr, otec Tekóův, měl dvě ženy: Cheleu a~Naaru.
\v 6 Naara mu porodila Achuzama, Chefera, Témního a~Achaštarího. To \it jsou\it* synové Naary.
\v 7 Synové Cheley: Seret, Sochar a~Etnán.
\v 8 Kós zplodil Anúba a~Sóbebu a~čeledě Acharchela, syna Harumova.
\p
\v 9 Jaebes byl váženější nežli jeho bratři. Jeho matka ho pojmenovala Jaebes se slovy: Vždyť jsem \it ho\it* porodila v~trápení.
\v 10 Ale Jaebes volal k~Bohu Izraele: Požehnej mi a~rozšiř mé území. Tvá ruka ať je se mnou. Učiň, ať \it jsem ochráněn\it* od zlého \it a\it*~nejsem trápen. A~Bůh splnil to, oč žádal.
\v 11 Kelúb, bratr Šúchův, zplodil Mechíra; ten \it je\it* otcem Eštóna.
\v 12 Eštón zplodil Bét‑ráfu, Paséacha, Techinu, otce Ír‑náchašova. To \it jsou\it* mužové Réky.
\p
\v 13 Synové Kenazovi: Otníel a~Serajáš. Synové Otníelovi: Chatat.
\v 14 Meónótaj zplodil Ofru, Serajáš zplodil Jóaba, otce Gé‑charašímu (\it Údolí řemeslníků\it*), neboť byli řemeslníci.
\p
\v 15 Synové Káleba, syna Jefunova: Irú, Éla a~Naam. Synové Élovi: Kenaz.
\v 16 Synové Jehalelélovi: Zíf, Zífa, Tírja a~Asarel.
\v 17 Synové Ezrovi: Jeter, Mered, Éfer a~Jalón. Otěhotněla \it a~porodila\it* Mirjama, Šamaje a~Jišbácha, otce Eštemoova.
\v 18 Jeho žena Judejka porodila Jereda, otce Gedórova, Chebera, otce Sókova, a~Jekutíela, otce Zanóachova. To \it jsou\it* synové Bitji, dcery faraonovy, kterou si vzal Mered.
\p
\v 19 Synové ženy Hódijášovy, sestry Nachamovy: otec Keíly Garmíťana a~Eštemóa Maakaťan.
\v 20 Synové Šímónovi: Amnón, Rina, Ben‑chanan a~Tilón. Synové Jišího: Zóchet a~Ben‑zóchet.
\v 21 Synové Šély, syna Judova: Ér, otec Léka, Laeda, otec Maréši, a~čeledi \it z\it*~dílny na jemné plátno v~Bét‑ašbeji.
\v 22 Jókím, mužové Kózeby, Jóaš a~Saraf, kteří panovali v~Moábu, a~Jašubi‑lechem. (To \it jsou\it* dávné události.)
\v 23 \it To\it* byli hrnčíři, kteří bydleli \it v\it*~Netajímu a~Gedeře. Pobývali tam u~krále v~jeho službě.
\s1 Synové Šimeónovi
\p
\v 24 Synové Šimeónovi: Nemúel, Jamín, Jaríb, Zerach \it a\it*~Šaúl,
\v 25 jeho syn Šalúm, jeho syn Mibsám \it a\it*~jeho syn Mišma.
\v 26 Synové Mišmovi: jeho syn Chamúel, jeho syn Zakúr \it a\it*~jeho syn Šimeí.
\v 27 Šimeí měl šestnáct synů a~šest dcer. Jeho bratři však mnoho synů neměli. Celá jejich čeleď se nerozmnožila tak jako synové Judovi.
\p
\v 28 Sídlili v~Beer‑šebě, Móladě, Chasar‑šúalu,
\v 29 Bilze, Esemu, Tóladu,
\v 30 Betúelu, Chormě, Siklagu,
\v 31 Bét‑markabótu, Chasar‑súsimu, Bét‑bireji a~Šaarajimu. To \it byla\it* jejich města až do Davidova kralování.
\v 32 Jejich dvorce \it byly\it*: Étam, Ajin, Rimón, Token a~Ašan, \it těchto\it* pět měst,
\v 33 a~všechny jejich dvorce, které \it byly\it* kolem těchto měst až k~Baalu. To \it byla\it* jejich sídla. Měli svoje rodokmeny.
\v 34 Dále Mešóbab, Jamlék a~Jóša, syn Amasjášův,
\v 35 Jóel a~Jehú, syn Jóšibjáše, syna Serajáše, syna Asíelova,
\v 36 Eljóenaj, Jaakoba, Ješochajáš, Asajáš, Adíel, Jesímiel, Benajáš
\v 37 a~Zíza, syn Šifího, syna Alóna, syna Jedajáše, syna Šimrího, syna Šemajášova.
\p
\v 38 Tito jmenovaní \it byli\it* předáky ve svých čeledích a~domy jejich otců se velice rozhojnily.
\v 39 Odešli ke Gedóru, až na východ údolí, aby hledali pastvu pro svá stáda.
\v 40 A~nalezli úrodnou a~dobrou pastvu, zemi rozlehlou \it na všechny\it* strany, poklidnou a~pokojnou. Předtím tam bydleli \it někteří\it* z~Chámovců.
\v 41 Tito jmenovitě zapsaní přišli ve dnech judského krále Chizkijáše, pobili jejich stany i~Meúnejce, kteří se tam nacházeli, a~zasvětili je zkáze, \it jak je tomu\it* dodnes. Usídlili se \it tam\it* místo nich, protože tam \it byla\it* pastva pro jejich stáda.
\p
\v 42 \it Někteří\it* z~nich, pět set mužů ze synů Šimeónových, šli do pohoří Seíru – Pelatjáš, Nearjáš, Refajáš a~Uzíel, syn Jišího, \it byli\it* v~jejich čele.
\v 43 Pobili ostatek těch, kteří vyvázli z~Amálekovců, a~zůstali tam až dodnes.
\c 5
\s1 Potomci Rúbenovi
\p
\v 1 Synové Rúbena, Izraelova prvorozeného; byl prvorozený, avšak když znesvětil lože svého otce, jeho prvorozenství bylo dáno synům Josefa, synům Izraelovým, a~nebyl zapsán do rodokmene jako prvorozený.
\v 2 Ačkoliv se Juda rozmohl nad své bratry a~\it vzešel\it* z~něho vévoda, prvorozenství dostal Josef.
\p
\v 3 Synové Rúbena, Izraelova prvorozeného: Chanók, Palú, Chesrón a~Karmí.
\v 4 Synové Jóelovi: Jeho syn Šemajáš, jeho syn Góg, jeho syn Šimeí,
\v 5 jeho syn Míka, jeho syn Reajáš, jeho syn Baal,
\v 6 jeho syn Beera, kterého odvedl asyrský král Tilgat‑pilneser; on \it byl\it* předákem Rúbenovců.
\p
\v 7 Jeho bratři podle čeledí, jak byli zapsáni do rodokmenů podle svých rodů: předák Jeíel, Zekarjáš,
\v 8 Bela, syn Azaza, syna Šemy, syna Jóelova; sídlil v~Aróeru a~až k~Nebó a~Baal‑meónu;
\v 9 na východě sídlil až k~okraji pustiny \it táhnoucí se\it* k~řece Eufratu, protože jejich stáda se v~gileádské zemi rozmnožila.
\v 10 Ve dnech Saulových vedli válku s~Hagrejci, kteří padli do jejich ruky; potom sídlili v~jejich stanech po celém povrchu \it země na\it* východ od Gileádu.
\s1 Potomci Gádovi
\p
\v 11 Synové Gádovi sídlili naproti nim v~bášanské zemi až po Salku.
\v 12 Předákem \it byl\it* Jóel, druhý Šafam, potom Jaenaj a~Šafat v~Bášanu.
\v 13 Jejich bratři podle domu svých otců: Michael, Mešulám, Šeba, Jóraj, Jaekán, Zía a~Eber, \it těchto\it* sedm.
\p
\v 14 Toto \it jsou\it* synové Abíchajila, syna Chúrího, syna Jaróacha, syna Gileáda, syna Michaela, syna Ješíšaje, syna Jachdóa, syna Búzova.
\v 15 Achí, syn Abdíela, syna Gúního, \it byl\it* předákem v~domě jejich otců.
\v 16 Sídlili v~Gileádu, v~Bášanu a~v~jeho vesnicích a~na všech pastvinách Šáronu až kam sahaly.
\v 17 Všichni byli zapsáni do rodokmene ve dnech judského krále Jótama a~ve dnech izraelského krále Jarobeáma.
\p
\v 18 Synové Rúbenovi, Gádovi a~polovina kmene Manasesova \it byli\it* bojovníci, muži, kteří nosili štít a~meč, napínali luk a~byli vycvičeni \it v\it*~boji; čtyřicet čtyři tisíc sedm set šedesát těch, kteří táhli \it s\it*~armádou.
\v 19 Vedli válku s~Hagrejci, \it s\it*~Jetúrem, Náfišem a~Nódabem.
\v 20 Dostalo se jim proti nim pomoci a~Hagrejci i~všichni, kdo \it byli\it* s~nimi, byli vydáni do jejich rukou, neboť volali k~Bohu o~pomoc v~boji a~\it on\it* se dal pohnout jejich prosbami, protože na něj spoléhali.
\v 21 Odvedli jejich stáda: padesát tisíc jejich velbloudů, dvě stě padesát tisíc ovcí, dva tisíce oslů a~sto tisíc lidí.
\v 22 Pobitých padlo mnoho, neboť ten boj \it byl\it* od Boha. Pak \it tam\it* sídlili místo nich až do vyhnanství.
\s1 Potomci poloviny kmene Manasesova
\p
\v 23 Potomci poloviny kmene Manasesova sídlili v~zemi od Bášanu až po Baal‑chermón a~Senír, horu Chermón; bylo jich mnoho.
\v 24 Toto \it jsou\it* předáci domu jejich otců: Éfer, Jiší, Elíel, Azríel, Jeremjáš, Hódavjáš a~Jachdíel, udatní hrdinové, věhlasní muži, předáci domu svých otců.
\v 25 Zpronevěřili se však Bohu svých otců, smilnili s~bohy národů země, které před nimi Bůh vyhladil.
\v 26 Bůh Izraele vzbudil ducha asyrského krále Púla a~ducha asyrského krále Tilgat‑pilnesera a~odvedl je – Rúbenovce, Gádovce a~polovinu kmene Manasesova – a~přivedl je do Chalachu, Chabóru, Hary a~\it k\it*~řece Gózanu, \it kde jsou\it* až dodnes.
\s1 Potomci Léviho
\p
\v 27 Synové Léviho: Geršón, Kehat a~Merarí.
\v 28 Synové Kehatovi: Amrám, Jishár, Chebrón a~Uzíel.
\p
\v 29 Synové Amrámovi: Áron a~Mojžíš, a~Mirjam. Synové Áronovi: Nádab, Abíhú, Eleazar a~Ítamar.
\p
\v 30 Eleazar zplodil Pinchasa, Pinchas zplodil Abíšúu,
\v 31 Abíšúa zplodil Bukího, Bukí zplodil Uzího,
\v 32 Uzí zplodil Zerachjáše, Zerachjáš zplodil Merajóta,
\v 33 Merajót zplodil Amarjáše, Amarjáš zplodil Achítúba,
\v 34 Achítúb zplodil Sádoka, Sádok zplodil Achímaase,
\v 35 Achímaas zplodil Azarjáše, Azarjáš zplodil Jóchanana,
\v 36 Jóchanan zplodil Azarjáše (toho, který sloužil jako kněz v~domě, jejž postavil Šalomoun v~Jeruzalémě),
\v 37 Azarjáš zplodil Amarjáše, Amarjáš zplodil Achítúba,
\v 38 Achítúb zplodil Sádoka, Sádok zplodil Šalúma,
\v 39 Šalúm zplodil Chilkijáše, Chilkijáš zplodil Azarjáše,
\v 40 Azarjáš zplodil Serajáše, Serajáš zplodil Jósadaka;
\v 41 a~Jósadak odešel, když Hospodin odvedl Judu a~Jeruzalém do zajetí prostřednictvím Nebúkadnesara.
\c 6
\v 1 Synové Léviho: Geršóm, Kehat a~Merarí.
\v 2 Toto \it jsou\it* jména synů Geršómových: Libní a~Šimeí.
\v 3 Synové Kehatovi: Amrám, Jishár, Chebrón a~Uzíel.
\v 4 Synové Merarího: Machlí a~Muší. Toto \it jsou\it* čeledi Léviho podle svých otců.
\v 5 Geršómovi: jeho syn Libní, jeho syn Jachat, jeho syn Zima,
\v 6 jeho syn Jóach, jeho syn Idó, jeho syn Zerach \it a\it*~jeho syn Jeotraj.
\v 7 Synové Kehatovi: jeho syn Amínadab, jeho syn Kórach, jeho syn Asír,
\v 8 jeho syn Elkána, jeho syn Ebjásaf, jeho syn Asír,
\v 9 jeho syn Tachat, jeho syn Uríel, jeho syn Uzijáš a~jeho syn Šaúl.
\v 10 Synové Elkánovi: Amasaj a~Achímót.
\v 11 Jeho syn Elkána, jeho syn Sófaj, jeho syn Nachat,
\v 12 jeho syn Elíab, jeho syn Jerochám \it a\it*~jeho syn Elkána.
\v 13 Synové Samuelovi: Prvorozený \it Jóel\it* a~druhý Abijáš.
\p
\v 14 Synové Merarího: Machlí, jeho syn Libní, jeho syn Šimeí, jeho syn Uza,
\v 15 jeho syn Šimea, jeho syn Chagijáš \it a\it*~jeho syn Asajáš.
\p
\v 16 A~toto \it jsou\it* ti, které ustanovil David nad pěveckými družinami \it v\it*~Hospodinově domě od \it doby, kdy\it* truhla \it získala\it* místo odpočinku.
\v 17 Sloužili písněmi před příbytkem stanu setkávání až do \it doby, kdy\it* Šalomoun postavil v~Jeruzalémě Hospodinův dům; sloužili podle nařízení o~jejich službě.
\v 18 Toto \it jsou\it* ti, kteří sloužili, a~jejich synové:
\p Ze synů Kehatových: zpěvák Héman, syn Jóela, syna Samuela,
\v 19 syna Elkány, syna Jerocháma, syna Elíela, syna Tóacha,
\v 20 syna Súfa, syna Elkány, syna Machata, syna Amasaje,
\v 21 syna Elkány, syna Jóela, syna Azarjáše, syna Sefanjáše,
\v 22 syna Tachata, syna Asíra, syna Ebjásafa, syna Kóracha,
\v 23 syna Jishára, syna Kehata, syna Léviho, syna Izraelova.
\p
\v 24 A jeho bratr Asaf, stojící po jeho pravici: Asaf, syn Berekjáše, syna Šimey,
\v 25 syna Michaela, syna Baasejáše, syna Malkijáše,
\v 26 syna Etního, syna Zeracha, syna Adajáše,
\v 27 syna Étana, syna Zimy, syna Šimeího,
\v 28 syna Jachata, syna Geršóma, syna Léviho.
\p
\v 29 A synové Merarího, jejich bratři, po levici: Étan, syn Kíšího, syna Abdího, syna Malúka,
\v 30 syna Chašabjáše, syna Amasjáše, syna Chilkijáše,
\v 31 syna Amsího, syna Baního, syna Šemera,
\v 32 syna Machlího, syna Mušího, syna Merarího, syna Léviho.
\p
\v 33 Jejich bratři lévité byli ustanoveni pro všechnu službu \it v\it*~příbytku Božího domu.
\v 34 Áron a~jeho synové pálili oběti na oltáři pro zápalné oběti a~na oltáři pro kadidlo, při veškeré službě nejsvětějšího \it místa\it*, aby získali smíření pro Izrael, tak jak přikázal Mojžíš, otrok Boží.
\v 35 Toto \it jsou\it* synové Áronovi: jeho syn Eleazar, jeho syn Pinchas, jeho syn Abíšúa,
\v 36 jeho syn Bukí, jeho syn Uzí, jeho syn Zerachjáš,
\v 37 jeho syn Merajót, jeho syn Amarjáš, jeho syn Achítúb,
\v 38 jeho syn Sádok \it a\it*~jeho syn Achímaas.
\p
\v 39 A toto \it jsou\it* jejich sídla podle jejich hradišť na jejich území: Synům Áronovým z~čeledi Kehatovců – protože jim padl los;
\v 40 dali jim Chebrón v~judské zemi a~jeho okolní pastviny.
\v 41 Pole toho města a~jeho dvorce však dali Kálebovi, synu Jefunovu.
\p
\v 42 Synům Áronovým dali útočištná města Chebrón, Libnu a~její pastviny, Jatír, Eštemóu a~její pastviny,
\v 43 Chílez a~jeho pastviny, Debír a~jeho pastviny,
\v 44 Ašan a~jeho pastviny, Bét‑šemeš a~jeho pastviny.
\v 45 Z~pokolení Benjamínova: Gebu a~její pastviny, Alemeta a~jeho pastviny, Anatót a~jeho pastviny. Všech jejich měst \it bylo\it* třináct podle jejich čeledí.
\p
\v 46 Zbývajícím synům Kehatovým z~čeledi toho pokolení \it bylo\it* losem \it přiděleno\it* z~poloviny pokolení Manasesova deset měst.
\p
\v 47 Synům Geršómovým podle jejich čeledí \it bylo přiděleno\it* z~pokolení Isacharova, z~pokolení Ašerova, z~pokolení Neftalího a~z~pokolení Manasesova v~Bášanu třináct měst.
\v 48 Synům Merarího pro jejich čeledi \it bylo\it* losem \it přiděleno\it* z~pokolení Rúbenova, z~pokolení Gádova a~z~pokolení Zabulónova dvanáct měst.
\v 49 Synové Izraele přidělili Lévijcům města a~jejich pastviny.
\v 50 Přidělili losem z~pokolení synů Judových, z~pokolení synů Šimeónových a~z~pokolení synů Benjamínových tato města, která jsou vyjmenována.
\p
\v 51 \it Některým\it* z~čeledí synů Kehatových připadla města jejich území z~pokolení Efrajimova.
\v 52 Dali jim útočištná města Šekem a~jeho pastviny v~Efrajimském pohoří, Gezer a~jeho pastviny,
\v 53 Jokmeám a~jeho pastviny, Bét‑chorón a~jeho pastviny,
\v 54 Ajalón a~jeho pastviny, Gat‑rimón a~jeho pastviny;
\v 55 a~z~poloviny pokolení Manasesova: Anér a~jeho pastviny a~Bileám a~jeho pastviny pro zbývající čeledi synů Kehatových.
\p
\v 56 Synům Geršómovým – z~čeledi poloviny pokolení Manasesova: Gólan v~Bášanu a~jeho pastviny a~Aštarót a~jeho pastviny;
\p
\v 57 z pokolení Isacharova: Kedeš a~jeho pastviny, Daberat a~jeho pastviny,
\v 58 Rámot a~jeho pastviny a~Aném a~jeho pastviny;
\p
\v 59 z pokolení Ašerova: Mášal a~jeho pastviny, Abdón a~jeho pastviny,
\v 60 Chukók a~jeho pastviny a~Rechób a~jeho pastviny;
\v 61 z~pokolení Neftalího: Kedeš v~Galileji a~jeho pastviny, Chamón a~jeho pastviny a~Kirjatajim a~jeho pastviny.
\p
\v 62 Zbývajícím synům Merarího – z~pokolení Zabulónova: Rimónó a~jeho pastviny \it a\it*~Tábor a~jeho pastviny;
\v 63 na druhé straně Jordánu \it u\it*~Jericha, na východ od Jordánu, z~pokolení Rúbenova: Beser v~pustině a~jeho pastviny, Jahas a~jeho pastviny,
\v 64 Kedemót a~jeho pastviny a~Méfaat a~jeho pastviny;
\v 65 z~pokolení Gádova: Rámot v~Gileádu a~jeho pastviny, Machanajim a~jeho pastviny,
\v 66 Chešbón a~jeho pastviny a~Jaezer a~jeho pastviny.
\c 7
\s1 Synové Isacharovi
\p
\v 1 Synové Isacharovi: Tóla, Púa, Jašúb a~Šimrón, \it tito\it* čtyři.
\p
\v 2 Synové Tólovi: Uzí, Refajáš, Jeríel, Jachmaj, Jibsám a~Samuel, předáci domu svých otců patřícího Tólovi, udatní hrdinové podle svých rodů. Jejich počet ve dnech Davidových \it byl\it* dvacet dva tisíc šest set.
\p
\v 3 Synové Uzího: Jizrachjáš. Synové Jizrachjášovi: Michael, Obadjáš, Jóel \it a\it*~Jišijáš, \it těchto\it* pět, všichni předáci.
\v 4 K~nim \it patřilo\it* podle jejich rodů, podle domu jejich otců, třicet šest tisíc \it mužů pro\it* bojeschopné vojenské oddíly, protože měli mnoho žen a~synů.
\v 5 Jeho bratrů ze všech Isacharových čeledí, udatných hrdinů, \it bylo\it* osmdesát sedm tisíc; všichni byli zapsáni do svých rodokmenů.
\s1 Synové Benjamínovi
\p
\v 6 \it Synové\it* Benjamínovi: Bela, Beker a~Jedíael, \it tito\it* tři.
\v 7 Synové Belovi: Esbón, Uzí, Uzíel, Jerímót a~Írí, \it těchto\it* pět, předáci domu otců, udatní hrdinové; do jejich rodokmenů \it jich\it* bylo zapsáno dvacet dva tisíc třicet čtyři.
\p
\v 8 Synové Bekerovi: Zemíra, Jóaš, Elíezer, Eljóenaj, Omrí, Jeremót, Abijáš, Anatót a~Alemet; tito všichni \it jsou\it* synové Bekerovi;
\v 9 byli zapsáni do rodokmenů podle svých rodů, předáci domu svých otců, udatní hrdinové – dvacet tisíc dvě stě.
\p
\v 10 Synové Jedíaelovi: Bilhán. Synové Bilhánovi: Jeúš, Benjamín, Ehúd, Kenaan, Zétan, Taršíš a~Achíšachar;
\v 11 tito všichni \it jsou\it* synové Jedíaelovi, předáci rodů, udatní hrdinové – sedmnáct tisíc dvě stě těch, kteří táhli \it s\it*~armádou do boje.
\v 12 Šupím a~Chupím \it byli\it* synové Írovi, Chuším – synové Achérovi.
\s1 Synové Neftalího
\p
\v 13 Synové Neftalího: Jachasíel, Gúní, Jeser a~Šalúm, synové Bilhy.
\s1 Synové Manasesovi
\p
\v 14 Synové Manasesovi: Asríel, kterého porodila jeho konkubína, Aramejka; porodila \it též\it* Makíra, otce Gileádova.
\v 15 Makír vzal ženu pro Chupíma a~Šupíma; jeho sestra se jmenovala Maaka. Druhý se jmenoval Selofchad. Selofchad měl \it jenom\it* dcery.
\v 16 Makírova žena Maaka porodila syna a~dala mu jméno Pereš. Jeho bratr se jmenoval Šereš, jeho synové Úlam a~Rekem.
\v 17 Synové Úlamovi: Bedán. To \it jsou\it* synové Gileáda, syna Makíra, syna Manasesova.
\v 18 Jeho sestra Moleket porodila Íšhóda, Abíezera a~Machlu.
\v 19 Synové Šemídovi byli: Achján, Šekem, Likchí a~Aníam.
\s1 Synové Efrajimovi
\p
\v 20 Synové Efrajimovi: Šútelach, jeho syn Bered, jeho syn Tachat, jeho syn Eleada, jeho syn Tachat,
\v 21 jeho syn Zábad, jeho syn Šútelach, Ezer a~Elead; zabili je však mužové Gatu zrození v~\it té\it* zemi, protože přišli, aby pobrali jejich stáda.
\v 22 Jejich otec Efrajim truchlil \it po\it* mnoho dní a~jeho bratři přišli, aby ho potěšili.
\v 23 Pak vešel ke své ženě, ta otěhotněla a~porodila syna. Dal mu jméno Bería, protože se v~jeho domě stalo neštěstí.
\v 24 Jeho dcerou \it byla\it* Šeera; ta postavila Bét‑chorón Dolní a~Horní a~Uzen‑šeeru.
\v 25 \it Dále\it* jeho syn Refach a~Rešef, jeho syn Telach, jeho syn Tachan,
\v 26 jeho syn Laedán, jeho syn Amíhud, jeho syn Elíšama,
\v 27 jeho syn Nún \it a\it*~jeho syn Jozue.
\p
\v 28 Jejich vlastnictví a~jejich sídla: Bét‑el a~jeho vesnice, na východě Naarán, na západě Gezer a~jeho vesnice, Šekem a~jeho vesnice až k~Aji a~jeho vesnicím,
\v 29 vedle \it území\it* synů Manasesových Bét‑šeán a~jeho vesnice, Taanak a~jeho vesnice, Megido a~jeho vesnice \it a\it*~Dór a~jeho vesnice. V~těchto sídlili synové Josefa, syna Izraelova.
\s1 Synové Ašerovi
\p
\v 30 Synové Ašerovi: Jimna, Jišva, Jišví, Bería a~jejich sestra Serach.
\v 31 Synové Beríovi: Cheber a~Malkíel; on \it je\it* otec Birzavitův.
\v 32 Cheber zplodil Jafleta, Šómera, Chótama a~jejich sestru Šúu.
\v 33 Synové Jafletovi: Pásak, Bimhál a~Ašvát; to \it jsou\it* synové Jafletovi.
\v 34 Synové Šemerovi: Achí, Rohga, Jechuba a~Aram.
\v 35 Syn jeho bratra Helema: Sófach, Jimna, Šeleš a~Ámal.
\v 36 Synové Sófachovi: Súach, Charnefer, Šúal, Berí, Jimrá,
\v 37 Beser, Hód, Šama, Šilša, Jitrán a~Beéra.
\v 38 Synové Jeterovi: Jefune, Pispa a~Ara.
\v 39 Synové Ulovi: Árach, Chaníel a~Risja.
\v 40 Ti všichni \it jsou\it* synové Ašerovi, předáci domu otců, vybraní udatní hrdinové, přední z~předáků. Do rodokmenů byli zapsáni podle vojenské bojeschopnosti; jejich počet \it byl\it* dvacet šest tisíc mužů.
\c 8
\s1 Synové Benjamínovi
\p
\v 1 Benjamín zplodil svého prvorozeného Belu, druhého Ašbela, třetího Achracha,
\v 2 čtvrtého Nóchu, pátého Ráfu.
\p
\v 3 Bela měl syny: Adára, Géru, Abíhúda,
\v 4 Abíšúu, Naamána, Achóacha,
\v 5 Géru, Šefúfana a~Chúrama.
\v 6 Toto \it jsou\it* synové Echúdovi – byli to předáci rodů obyvatel Geby, kteří je odvedli do Manachatu –
\v 7 Naamán, Achijáš a~Géra, který je odvedl. Zplodil Uzu a~Achíchuda.
\p
\v 8 Šacharajim zplodil \it syny\it* na moábském poli, když poslal pryč své ženy Chušímu a~Baaru.
\v 9 Se svou ženou Chódeší zplodil Jóbaba, Sibju, Méšu, Malkáma,
\v 10 Jeúsa, Sakeju a~Mirmu; toto \it jsou\it* jeho synové, předáci rodů.
\v 11 S~Chúšimou zplodil Abítúba a~Elpaala.
\p
\v 12 Synové Elpaalovi: Eber, Mišeám, Šemed, který postavil Óno a~Lód s~jeho vesnicemi,
\v 13 a~Bería a~Šema; byli \it to\it* předáci rodů obyvatel Ajalónu; ti vyhnali obyvatele Gatu.
\v 14 Achjó, Šášak, Jeremót,
\v 15 Zebadjáš, Arad, Eder,
\v 16 Michael, Jišpa a~Jócha \it byli\it* synové Beríovi.
\v 17 Zebadjáš, Mešulám, Chizkí, Cheber,
\v 18 Jišmeraj, Jizliá a~Jóbab \it byli\it* synové Elpaalovi.
\v 19 Jakím, Zikrí, Zabdí,
\v 20 Elíenaj, Siletaj, Elíel,
\v 21 Adajáš, Berajáš a~Šimrat \it byli\it* synové Šimeího.
\v 22 Jišpán, Eber, Elíel,
\v 23 Abdón, Zikrí, Chánan,
\v 24 Chananjáš, Élam, Antótijáš,
\v 25 Jifdejáš a~Penúel \it byli\it* synové Šášakovi.
\v 26 Šamšeraj, Šecharjáš, Ataljáš,
\v 27 Jaarešjáš, Elijáš a~Zikrí \it byli\it* synové Jerochámovi.
\v 28 Toto \it jsou\it* předáci rodů podle svých rodů; tito předáci sídlili v~Jeruzalémě.
\p
\v 29 V Gibeónu sídlil otec Gibeónův; jeho žena se jmenovala Maaka.
\v 30 Jeho prvorozený syn \it byl\it* Abdón, \it dále\it* Súr, Kíš, Baal, Nádab,
\v 31 Gedór, Achjó a~Zeker.
\v 32 Miklót zplodil Šimeu. Také oni sídlili naproti svým bratrům v~Jeruzalémě, se svými bratry.
\p
\v 33 Nér zplodil Kíše, Kíš zplodil Saula, Saul zplodil Jónatana, Malkíšúu, Abínádaba a~Ešbaala.
\v 34 Syn Jónatanův: Meríb‑baal; Meríb‑baal zplodil Míku.
\p
\v 35 Synové Míkovi: Pítón, Melek, Taréa a~Achaz.
\v 36 Achaz zplodil Jójadu, Jójada zplodil Alemeta, Azmáveta a~Zimrího. Zimrí zplodil Mósu.
\v 37 Mósa zplodil Bineu; jeho syn \it byl\it* Ráfa, jeho syn Eleása, jeho syn Ásel.
\v 38 Ásel měl šest synů. Toto \it jsou\it* jejich jména: Azríkam, Bokrú, Jišmael, Šearjáš, Obadjáš a~Chánan. Ti všichni \it byli\it* synové Áselovi.
\v 39 Synové jeho bratra Ešeka: Jeho prvorozený Úlam, druhý Jeúš a~třetí Elífelet.
\v 40 Synové Úlamovi byli udatní hrdinové, lukostřelci. Měli mnoho synů a~vnuků, \it celkem\it* sto padesát. Ti všichni \it byli\it* ze synů Benjamínových.
\c 9
\s1 Obyvatelé Jeruzaléma
\p
\v 1 Všichni Izraelci byli zapsáni do rodokmenů. Ano, jsou zapsáni v~Knize izraelských králů. Judejci byli odvedeni do Babylona pro svou věrolomnost.
\p
\v 2 První, kdo se \it znovu\it* usídlili na svém vlastnictví, ve svých městech, \it byli\it* Izraelci, kněží, lévité a~chrámoví nevolníci.
\v 3 V~Jeruzalémě sídlili \it někteří\it* ze synů Judových, ze synů Benjamínových, ze synů Efrajimových a~Manasesových.
\v 4 Útaj, syn Amíhuda, syna Omrího, syna Imrího, syna Baního ze synů Peresa, syna Judova.
\v 5 Ze Šíloanů prvorozený Asajáš a~jeho synové.
\v 6 Ze synů Zerachových Jeúel a~jeho bratři, \it celkem\it* šest set devadesát.
\v 7 Ze synů Benjamínových Salú, syn Mešuláma, syna Hódavjáše, syna Hasenuova,
\v 8 a~Jibnejáš, syn Jerochámův, a~Éla, syn Uzího, syna Mikrího, a~Mešulám, syn Šefatjáše, syna Reúela, syna Jibnijášova,
\v 9 a~jejich bratři podle svých rodů, \it celkem\it* devět set padesát šest. Ti všichni \it byli\it* předáci rodů podle domu svých otců.
\p
\v 10 Z kněží: Jedajáš, Jójaríb, Jakín,
\v 11 Azarjáš, syn Chilkijáše, syna Mešuláma, syna Sádoka, syna Merajóta, syna Achítúba, představený Božího domu;
\p
\v 12 Adajáš, syn Jerocháma, syna Pašchúra, syna Malkijáše, Maasaj, syn Adíela, syna Jachzéry, syna Mešuláma, syna Mešilemíta, syna Imerova,
\v 13 a~jejich bratři, předáci domu svých otců, \it celkem\it* tisíc sedm set šedesát, udatní hrdinové \it pro\it* dílo služby Božího domu.
\p
\v 14 Z lévitů: Šemajáš, syn Chašúba, syna Azríkama, syna Chašabjáše, ze synů Merarího.
\v 15 Bakbakar, Chereš a~Gálal, Matanjáš, syn Míky, syna Zikrího, syna Asafova,
\v 16 Obadjáš, syn Šemajáše, syna Gálala, syna Jedútúnova, a~Berekjáš, syn Ásy, syna Elkánova, který sídlil v~netófatských dvorcích.
\v 17 Vrátní: Šalúm, Akúb, Talmón, Achíman a~jejich bratři; Šalúm \it byl\it* předákem
\v 18 a~\it je\it* až doposud v~královské bráně na východě. \it Tito\it* byli vrátní patřící \it k\it*~táboru synů Léviho.
\v 19 Šalúm, syn Kórého, syna Ebjásafa, syna Kóracha, a~jeho bratři domu jeho otce, Kórachovci \it byli ustanoveni\it* nad dílem služby \it jako\it* strážci prahů stanu; jejich otcové \it byli\it* nad Hospodinovým táborem \it jako\it* strážci vchodu.
\v 20 Předtím byl vévodou nad nimi Pinchas, syn Eleazarův; Hospodin \it byl\it* s~ním.
\v 21 Zekarjáš, syn Mešelemjášův, \it byl\it* vrátným \it u\it*~vchodu do stanu setkávání.
\v 22 Všech vybraných za vrátné prahů \it bylo\it* dvě stě dvanáct. Byli zapsáni do rodokmenů ve svých dvorcích. Tyto určil David a~vidoucí Samuel pro jejich poctivost.
\v 23 Oni a~jejich synové \it byli ustanoveni\it* nad branami Hospodinova domu, stanového domu, jako stráže.
\v 24 Vrátní byli na čtyřech stranách: \it na\it* východě, na západě, na severu a~na jihu.
\v 25 Jejich bratři \it sídlící\it* ve svých dvorcích \it měli\it* čas od času přicházet na sedm dní, \it aby byli\it* s~nimi.
\v 26 Protože byli poctiví, čtyři hlavní vrátní, lévité, byli \it ustanoveni\it* nad komorami a~nad pokladnicemi Božího domu.
\v 27 Zůstávali přes noc \it v\it*~okolí Božího domu, neboť jim \it byla svěřena\it* stráž a~ráno co ráno odemykali.
\v 28 \it Někteří\it* z~nich \it byli\it* nad \it boho\it*služebnými předměty – podle počtu je přinášeli a~podle počtu je odnášeli.
\v 29 \it Někteří\it* z~nich byli pověřeni nad předměty a~nad všemi posvátnými nádobami, nad moukou, vínem, olejem, kadidlem a~balzámy.
\v 30 \it Někteří\it* ze synů kněží připravovali masti pro balzámy.
\v 31 Matitjáš z~lévitů, prvorozený Kórachovce Šalúma, \it byl\it* stále nad pečením placek.
\v 32 \it Někteří\it* ze synů Kehatových, z~jejich bratrů, \it byli\it* sobotu \it co\it* sobotu nad přípravou předkladných chlebů.
\p
\v 33 Toto \it jsou\it* zpěváci, předáci lévijských rodů; \it zůstávali\it* v~síních, osvobozeni \it od jiné služby\it*, protože ve dne v~noci na nich \it spočívala\it* služba.
\v 34 Toto \it jsou\it* předáci lévijských rodů podle svých rodů. Tito předáci sídlili v~Jeruzalémě.
\s1 Saulův rodokmen
\p
\v 35 V~Gibeónu sídlil Jeíel, otec Gibeónův; jeho žena se jmenovala Maaka.
\v 36 Jeho prvorozený syn \it byl\it* Abdón, \it dále\it* Súr, Kíš, Baal, Nér, Nádab,
\v 37 Gedór, Achjó, Zekarjáš a~Miklót.
\v 38 Miklót zplodil Šimeama. Také oni sídlili naproti svým bratrům v~Jeruzalémě, se svými bratry.
\p
\v 39 Nér zplodil Kíše, Kíš zplodil Saula, Saul zplodil Jónatana, Malkíšúu, Abínádaba a~Ešbaala.
\v 40 Jónatanův syn \it byl\it* Meríb‑baal; Merí‑baal zplodil Míku.
\v 41 Synové Míkovi: Pítón, Melek, Tachréa.
\v 42 Achaz zplodil Jaeru, Jaera zplodil Alemeta, Azmáveta a~Zimrího. Zimrí zplodil Mósu.
\v 43 Mósa zplodil Bineu; jeho syn \it byl\it* Refajáš, jeho syn Eleása, jeho syn Ásel.
\v 44 Ásel měl šest synů. Toto \it jsou\it* jejich jména: Azríkam, Bokrú, Jišmael, Šearjáš, Obadjáš a~Chánan. Toto \it byli\it* synové Áselovi.
\c 10
\s1 Saulova smrt
\p
\v 1 Pelištejci bojovali proti Izraeli. Izraelci před Pelištejci utíkali a~padali pobiti v~pohoří Gilbóa.
\v 2 Pelištejci stíhali Saula a~jeho syny. Pak Pelištejci zabili Jónatana, Abínádaba a~Malkíšúu, Saulovy syny.
\v 3 Bitva na Saula těžce dolehla. Našli ho lukostřelci a~svíjel se bolestí, protože \it ho\it* postřelili.
\v 4 Saul řekl svému zbrojnošovi: Vytáhni svůj meč a~probodni mě jím. Jinak přijdou ti neobřezanci a~budou se mi posmívat. Ale zbrojnoš nechtěl, protože se hrozně bál. Saul tedy vzal meč a~padl na něj.
\v 5 Když zbrojnoš viděl, že Saul je mrtev, také on padl na meč a~zemřel.
\p
\v 6 Tak zemřel Saul i~jeho tři synové, všichni \it z\it*~jeho domu zemřeli společně.
\v 7 Když všichni Izraelci, kteří \it byli\it* v~údolí, viděli, že utekli a~že Saul i~jeho synové zemřeli, opustili svá města a~utekli. Pelištejci přišli a~bydleli v~nich.
\p
\v 8 Příštího dne se stalo, že přišli Pelištejci, aby rabovali pobité. Našli Saula a~jeho syny padlé v~pohoří Gilbóa.
\v 9 Svlékli ho, odnesli jeho hlavu a~jeho zbroj a~poslali kolovat po pelištejské zemi, aby přinášeli novinu svým modlářským zpodobeninám a~lidu.
\v 10 Jeho zbroj uložili \it v\it*~domě svého boha a~jeho lebku připevnili \it v\it*~Dágonově domě.
\p
\v 11 Když se všichni \it obyvatelé\it* Jábeše v~Gileádu doslechli o~všem, co Pelištejci Saulovi provedli,
\v 12 všichni bojovníci povstali, odnesli tělo Saulovo i~těla jeho synů, přinesli je do Jábeše a~pohřbili jejich kosti pod terebintem v~Jábeši.
\p
\v 13 Saul zemřel pro svou věrolomnost, když se zpronevěřil Hospodinu, Hospodinovu slovu, které nezachoval, a~také se doptával ducha \it zemřelého\it*, aby se dotázal \it na radu\it*,
\v 14 a~nedotazoval se Hospodina. \it On\it* ho usmrtil a~přenesl království na Davida, syna Jišajova.
\c 11
\s1 David králem nad Izraelem
\p
\v 1 Všichni Izraelci se shromáždili k~Davidovi do Chebrónu se slovy: Hle, jsme tvá kost a~tvé tělo.
\v 2 Již dávno předtím, když byl králem ještě Saul, jsi vodil Izrael \it do boje i~z~boje\it* ty. Hospodin, můj Bůh, ti řekl: Ty budeš pást můj lid Izrael, ty budeš vévodou nad mým lidem Izraelem.
\v 3 Všichni izraelští starší přišli ke králi do Chebrónu a~David s~nimi v~Chebrónu před Hospodinem uzavřel smlouvu. Pomazali Davida za krále nad Izraelem podle Hospodinova slova prostřednictvím Samuela.
\p
\v 4 Pak David a~celý Izrael vytáhl \it na\it* Jeruzalém, to \it je\it* Jebús; tam \it byli\it* Jebúsejci, obyvatelé té země.
\v 5 Obyvatelé Jebúsu řekli Davidovi: Nevstoupíš sem. Ale David dobyl pevnost Sijón, to \it je\it* Město Davidovo.
\v 6 David řekl: Ten, kdo udeří \it na\it* Jebúsejce první, stane se předákem a~velitelem. První vytáhl Jóab, syn Serújin, a~stal se předákem.
\v 7 A~David se v~pevnosti usadil – proto se nazývala Město Davidovo.
\v 8 Postavil město všude kolem, od Miló na všechny strany. Zbytek města obnovil Jóab.
\v 9 David se stále rozmáhal a~Hospodin zástupů \it byl\it* s~ním.
\p
\v 10 Toto \it jsou\it* předáci Davidových hrdinů, kteří ho podporovali v~jeho kralování spolu s~celým Izraelem, aby ho ustanovili králem podle Hospodinova slova o~Izraeli.
\s1 Davidovi hrdinové
\p
\v 11 Toto \it je\it* výčet Davidových hrdinů:
\p Jášobeám, syn Chachmóního, vůdce kapitánů, který zamával svým kopím proti třem stům, \it jež\it* naráz pobil.
\p
\v 12 Po něm \it byl\it* Eleazar, syn Dóda Achóchijského, který \it byl\it* mezi těmi třemi hrdiny.
\v 13 Byl s~Davidem v~Pas‑damímu, když se tam Pelištejci shromáždili k~boji. Byl \it tam\it* díl pole plný ječmene. Lid před Pelištejci utekl.
\v 14 Postavili se uprostřed toho pole, vysvobodili ho a~Pelištejce pobili. Hospodin způsobil velkou záchranu.
\p
\v 15 Tři z~těch třiceti vůdců sestoupili na skálu k~Davidovi do adulamské jeskyně. Pelištejské vojsko tábořilo v~údolí Refájců.
\v 16 David \it byl\it* tehdy v~pevnosti a~pelištejská posádka \it byla\it* tehdy v~Betlémě.
\v 17 David zatoužil a~řekl: Kdyby mi \it tak\it* někdo dal napít vody z~betlémské studny, která \it je\it* u~brány!
\v 18 Ti tři pronikli do pelištejského tábora, načerpali vodu z~betlémské studny, která \it je\it* u~brány, vzali \it ji\it* a~přinesli Davidovi. David však nechtěl pít a~vylil ji Hospodinu \it v~úlitbu\it*.
\v 19 Řekl: Ať je to ode mě vzdáleno, můj Bože, abych udělal \it něco\it* takového. Což \it smím\it* pít krev těchto mužů, \it kteří šli\it* s~\it nasazením\it* vlastního života? Vždyť ji přinesli s~\it nasazením\it* vlastního života. A~nechtěl ji pít. To udělali ti tři hrdinové.
\p
\v 20 Abíšaj, bratr Jóabův, byl vůdcem tří. Zamával svým kopím proti třem stům, \it jež\it* pobil. Proslavil se mezi \it těmi\it* třemi.
\v 21 Z~těch tří byl váženější než \it druzí\it* dva a~stal se jejich velitelem, ale oněch \it prvních\it* tří nedosáhl.
\p
\v 22 Benajáš, syn Jójadův, \it byl\it* bojovník z~Kabseelu, \it který učinil\it* mnoho \it mocných\it* činů. Ten zabil dva \it syny\it* Aríele Moábského. On také přišel a~v~čase sněhu ubil lva v~jámě.
\v 23 Zabil Egypťana, muže měřícího pět loket. Egypťan \it měl\it* v~ruce kopí jako tkalcovské vratidlo. \it On\it* k~němu přišel s~holí, sebral kopí z~Egypťanovy ruky a~jeho \it vlastním\it* kopím ho zabil.
\v 24 Tyto \it činy\it* vykonal Benajáš, syn Jójadův, a~proslavil se mezi třemi hrdiny.
\v 25 Mezi třiceti byl nejváženější, ale oněch tří nedosáhl. David ho ustanovil nad svou tělesnou stráží.
\p
\v 26 Udatný hrdina: Asáel, bratr Jóabův, Elchánan, syn Dóda z~Betléma,
\p
\v 27 Šamót Harórský, Cheles Pelónský,
\p
\v 28 Íra, syn Íkeše Tekójského, Abíezer Anatótský,
\v 29 Sibekaj Chúšatský, Ílaj Achóchijský,
\p
\v 30 Mahraj Netófský, Cheled, syn Baany Netófského,
\v 31 Ítaj, syn Ríbaje z~Gibeje synů Benjamínových, Benajáš Pireatónský,
\v 32 Chúraj z~gaašských údolí, Abíel Arbátský,
\p
\v 33 Azmávet Bacharúmský, Eljachba Šaalbónský,
\v 34 synové Hašema Gizónského, Jónatan, syn Šagéa Hararského,
\v 35 Achíam, syn Sakara Hararského, Elífal, syn Úrův,
\p
\v 36 Chefer Mekeratský, Achijáš Pelónský,
\p
\v 37 Chesró Karmelský, Naaraj, syn Ezbajův,
\p
\v 38 Jóel, bratr Nátanův, Mibchár, syn Hagrího,
\p
\v 39 Selek Amónský, Nacharaj Beerótský, zbrojnoš Jóaba, syna Serújina,
\p
\v 40 Íra Jitrejský, Gáreb Jitrejský,
\p
\v 41 Urijáš Chetejský, Zábad, syn Achlájův,
\p
\v 42 Adína, syn Šízy Rúbenského, vůdce Rúbenovců a~nad třiceti,
\p
\v 43 Chánan, syn Maakův, Jóšafat Mitnejský,
\p
\v 44 Uzija Ašterátský, Šama a~Jeíel, synové Chótama Aróerského,
\p
\v 45 Jedíael, syn Šimrího, \it a\it*~jeho bratr Jócha Tisejský,
\p
\v 46 Elíel Machavímský, Jeríbaj a~Jóšavjáš, synové Elnaamovi, Jitma Moábský,
\v 47 Elíel, Obéd a~Jaasíel Mesóbajští.
\c 12
\s1 Davidovi hrdinové
\p
\v 1 Tito přišli do Siklagu za Davidem, \it když\it* se ještě skrýval před Saulem, synem Kíšovým; byli mezi hrdiny, kteří pomáhali \it v\it*~boji;
\v 2 byli ozbrojeni lukem \it a~uměli\it* používat pravou i~levou ruku na \it vrhání\it* kamenů i~\it střílení\it* šípů z~luku; \it byli\it* ze Saulových bratrů, z~Benjamína:
\v 3 Achíezer, vůdce, a~Jóaš, synové Šemay Gibeatského, Jezíel a~Pelet, synové Azmávetovi, Beraka, Jehú Anatótský,
\v 4 Jišmajáš Gibeónský, hrdina mezi třiceti a~nad třiceti,
\v 5 Jeremjáš, Jachazíel, Jóchanan, Józabad Gederatský,
\v 6 Eleúzaj, Jerímót, Bealjáš, Šemarjáš, Šefatjáš Charufský,
\v 7 Elkána, Jišijáš, Azarel, Jóezer, Jášobeám, Kórachovci,
\v 8 Jóela a~Zebadjáš, synové Jerocháma z~Gedóru.
\v 9 Z~Gádovců přešli k~Davidovi do pevnosti v~pustině udatní hrdinové, bojeschopní vojáci, vyzbrojení štítem a~oštěpem; vypadali \it jako\it* lev a~rychlí byli jako gazely na horách.
\p
\v 10 Vůdce \it byl\it* Ezer, druhý Obadjáš, třetí Elíab,
\v 11 čtvrtý Mišmana, pátý Jeremjáš,
\v 12 šestý Ataj, sedmý Elíel,
\v 13 osmý Jóchanan, devátý Elzabad,
\v 14 desátý Jeremjáš, jedenáctý Makbanaj.
\v 15 Toto \it jsou\it* vůdcové armády ze synů Gádových. Nejmenší za sto, největší za tisíc.
\v 16 To \it jsou\it* ti, kteří prošli Jordánem v~prvním měsíci, kdy se rozlévá na oba své břehy, a~vyhnali všechny \it žijící v\it*~údolích na východ a~na západ.
\p
\v 17 Přišli také \it někteří\it* ze synů Benjamínových a~Judejci do pevnosti k~Davidovi.
\v 18 David před ně vyšel a~promluvil k~nim: Jestliže ke mně přicházíte v~pokoji, abyste mi pomohli, budu s~vámi zajedno; jestliže však abyste mě zradili mým protivníkům, ačkoli na mých rukou není násilí, \it ať\it* pohledí Bůh našich otců a~rozsoudí.
\v 19 Duch vyzbrojil Amasaje, vůdce kapitánů, \it takže řekl\it*: Tobě patříme, Davide, s~tebou \it jsme\it*, synu Jišajův. Pokoj, pokoj tobě, pokoj tvým pomocníkům, vždyť ti pomáhá tvůj Bůh. David je přijal a~ustanovil je vůdci oddílů.
\p
\v 20 \it Někteří\it* z~Manasesa přeběhli k~Davidovi, když táhl s~Pelištejci do boje proti Saulovi. Ale nepomáhali jim, neboť když se pelištejská knížata poradila, propustila ho se slovy: Přeběhl by s~našimi hlavami ke svému pánu Saulovi.
\v 21 Když šel do Siklagu, přeběhli k~němu \it někteří\it* z~Manasesa: Adnach, Józabad, Jedíael, Michael, Józabad, Elíhú a~Siletaj, předáci Manasesových rodů.
\v 22 Ti přišli Davidovi na pomoc proti loupežné hordě, neboť \it byli\it* všichni udatní hrdinové; stali se veliteli v~armádě.
\v 23 Den co den přicházeli \it lidé\it* Davidovi na pomoc, až \it bylo\it* vojsko velké jako vojsko Boží.
\s1 Davidovo vojsko v~Chebrónu
\p
\v 24 Toto \it jsou\it* počty vůdců vojenských ozbrojenců, \it kteří\it* přišli k~Davidovi do Chebrónu, aby na něj podle Hospodinova příkazu přenesli Saulovo království:
\v 25 Synů Judových, kteří nosili štít a~oštěp, \it bylo\it* šest tisíc osm set vojenských ozbrojenců;
\p
\v 26 ze synů Šimeónových sedm tisíc jedno sto udatných hrdinů pro vojenskou službu;
\p
\v 27 ze synů Léviho čtyři tisíce šest set;
\p
\v 28 Jójada, vévoda Áronovců, a~s~ním tři tisíce sedm set;
\p
\v 29 Sádok, mladý udatný hrdina, a~dům jeho otce, dvacet dva velitelů;
\p
\v 30 ze synů Benjamínových, Saulových bratrů, tři tisíce; až doposud jich většina zachovávala službu domu Saulova;
\p
\v 31 ze synů Efrajimových dvacet tisíc osm set udatných hrdinů, věhlasných mužů v~domě jejich otců;
\p
\v 32 z poloviny pokolení Manasesova osmnáct tisíc těch, kteří byli jmenovitě určeni, aby šli ustanovit Davida králem;
\p
\v 33 ze synů Isacharových, kteří byli schopni rozumět časům a~věděli, co \it má\it* Izrael dělat, dvě stě jejich předáků a~všichni jejich bratři podle jejich příkazu;
\p
\v 34 ze Zabulóna ti, kteří táhli \it s\it*~armádou připraveni \it do\it* boje s~všelijakými válečnými zbraněmi, padesát tisíc, hotových nastoupit bez bázně a~hany;
\p
\v 35 z Neftalího tisíc velitelů a~s~nimi třicet sedm tisíc \it mužů\it* se štítem a~kopím;
\p
\v 36 z Danovců připravení \it do\it* boje – dvacet osm tisíc šest set;
\p
\v 37 z Ašera ti, kteří táhli \it s\it*~armádou připravení \it do\it* boje – čtyřicet tisíc;
\p
\v 38 z druhé strany Jordánu z~Rúbenovců, Gádovců a~poloviny kmene Manasesova se všelijakými vojenskými válečnými zbraněmi – sto dvacet tisíc.
\p
\v 39 Všichni tito bojovníci hotoví nastoupit \it na\it* bojiště přišli s~celým srdcem do Chebrónu ustanovit Davida králem nad celým Izraelem. Také všichni ostatní Izraelci \it byli\it* jednomyslní, že ustanoví Davida králem.
\v 40 Byli tam s~Davidem tři dny, jedli a~pili, neboť jejich bratři jim \it to\it* připravili.
\v 41 A~také jejich příbuzní až z~Isachara, Zabulóna a~Neftalího přiváželi potravu na oslech, velbloudech, mezcích a~volech – moučná jídla, koláče \it z\it*~lisovaných fíků, sušené hrozny, víno, olej, skot a~brav v~hojnosti, neboť v~Izraeli \it byla\it* radost.
\c 13
\s1 Přenesení truhly
\p
\v 1 David se poradil s~veliteli \it nad\it* tisíci a~\it nad\it* sty, se všemi vévody.
\v 2 Pak řekl David celému shromáždění Izraele: Jestliže se vám \it to\it* líbí a~\it je to\it* od Hospodina, našeho Boha, rozšiřme \it všude\it* vzkaz svým bratrům, kteří zůstali na různých územích Izraele, a~s~nimi kněžím a~lévitům do jejich měst \it s~okolními\it* pastvinami, ať se k~nám shromáždí,
\v 3 a~přeneseme truhlu našeho Boha k~nám, neboť ve dnech Saulových jsme ji nevyhledávali.
\v 4 Celé shromáždění řeklo, aby se to udělalo, protože se to všemu lidu líbilo.
\p
\v 5 David shromáždil celý Izrael od egyptského Šíchoru až po Lebo‑Chamát, aby přenesli z~Kirjat‑jearímu Boží truhlu.
\v 6 David a~celý Izrael vystoupil do Baaly, do Kirjat‑jearímu, který \it je\it* v~Judsku, aby odtamtud přenesli truhlu Boha, Hospodina sedícího \it na\it* cherubech, která se nazývá \it jeho\it* jménem.
\v 7 Naložili Boží truhlu na nový vůz \it a~vezli\it* z~Abínádabova domu; Uza a~Achjó vůz vedli
\v 8 a~David i~celý Izrael se radovali před Bohem ze vší síly – s~písněmi, lyrami, harfami, tamburínami, činely a~trubkami.
\p
\v 9 Když přišli ke Kidónovu humnu, vztáhl Uza ruku, aby podržel truhlu, protože voli opustili \it cestu\it*.
\v 10 Hospodinův hněv vzplál proti Uzovi a~zabil ho, protože vztáhl ruku na truhlu; zemřel tam před Bohem.
\v 11 David se rozzlobil, že se Hospodin prudce obořil na Uzu a~nazval to místo Peres‑uza, \it jak je tomu\it* dodnes.
\v 12 Toho dne se David \it začal\it* bát Boha a~řekl: Jak \it bych\it* k~sobě \it mohl\it* přenést Boží truhlu?
\v 13 A~David nevzal truhlu k~sobě do Města Davidova, ale odsunul ji do domu Obéd‑edóma Gatského.
\v 14 Boží truhla zůstala s~domem Obéd‑edómovým tři měsíce a~Hospodin žehnal domu Obéd‑edóma i~všemu, co mu patřilo.
\c 14
\s1 Davidův dům
\p
\v 1 Týrský král Chíram poslal k~Davidovi posly a~cedrové dřevo, kameníky a~tesaře, aby mu postavili dům.
\v 2 David věděl, že Hospodin ho určil za krále nad Izraelem \it a\it*~že se jeho království velmi povzneslo kvůli jeho lidu Izraeli.
\p
\v 3 David si v~Jeruzalémě vzal další ženy a~zplodil další syny a~dcery.
\v 4 Toto \it jsou\it* jména dětí, které měl v~Jeruzalémě: Šamúa, Šóbab, Nátan, Šalomoun,
\v 5 Jibchár, Elíšúa, Elpelet,
\v 6 Nógah, Nefeg, Jafía,
\v 7 Elíšama, Beeljáda, Elífelet.
\s1 David poráží Pelištejce
\p
\v 8 Když se Pelištejci doslechli, že byl David pomazán za krále nad celým Izraelem, všichni Pelištejci vytáhli Davida hledat. Když se \it to\it* David doslechl, vytáhl proti nim.
\v 9 Pelištejci přitáhli a~vtrhli do údolí Refájců.
\v 10 David se doptával Boha: Mám proti Pelištejcům vytáhnout? Vydáš je do mé ruky? Hospodin mu odpověděl: Vytáhni. Vydám je do tvé ruky.
\v 11 Vytáhli do Baal‑perasímu a~tam je David pobil. A~David řekl: Bůh protrhl mé nepřátele skrze mě jako voda protrhuje \it hráz\it*. Proto pojmenovali to místo Baal‑perasím.
\v 12 Zanechali tam své bohy a~David přikázal, aby byli spáleni ohněm.
\p
\v 13 Pelištejci znovu \it vytáhli\it* a~vtrhli do údolí.
\v 14 David se znovu doptával Boha a~Bůh mu řekl: Netáhni za nimi. Obejdi je a~přitáhni k~nim směrem od balzámovníků.
\v 15 I~stane se, až uslyšíš zvuk pochodování ve vrcholcích balzámovníků, tehdy vytáhni do boje, protože Bůh vytáhne před tebou, aby pelištejské vojsko pobil.
\v 16 David učinil tak, jak mu Bůh přikázal, a~pobíjeli pelištejské vojsko od Gibeónu až do Gezeru.
\v 17 Davidovo jméno proniklo do všech zemí a~Hospodin uvalil strach \it z\it*~něj na všechny národy.
\c 15
\s1 Služebníci u~Hospodinovy truhly
\p
\v 1 Postavil pro sebe domy v~Městě Davidově a~připravil místo pro Boží truhlu, postavil pro ni stan.
\v 2 Tehdy David řekl: \it Nikdo\it* nesmí nosit Boží truhlu, jenom lévité, neboť je Hospodin vyvolil, aby nosili Hospodinovu truhlu a~sloužili mu navěky.
\v 3 David shromáždil celý Izrael do Jeruzaléma, aby přenesli Hospodinovu truhlu na místo, které pro ni připravil.
\v 4 David shromáždil syny Áronovy a~lévity:
\v 5 Ze synů Kehatových předáka Uríela a~jeho bratry – sto dvacet;
\p
\v 6 ze synů Merarího předáka Asajáše a~jeho bratry – dvě stě dvacet;
\p
\v 7 ze synů Geršómových předáka Jóela a~jeho bratry – sto třicet;
\p
\v 8 ze synů Elísáfanových předáka Šemajáše a~jeho bratry – dvě stě;
\p
\v 9 ze synů Chebrónových předáka Elíela a~jeho bratry – osmdesát;
\p
\v 10 ze synů Uzíelových předáka Amínadaba a~jeho bratry – sto dvanáct.
\p
\v 11 David zavolal kněze Sádoka a~Ebjátara i~lévity Uríela, Asajáše, Jóela, Šemajáše, Elíela a~Amínadaba
\v 12 a~řekl jim: Vy \it jste\it* předáci lévijských rodů; posvěťte se, vy i~vaši bratři, a~přeneste truhlu Hospodina, Boha Izraele, na \it místo, které\it* jsem pro ni připravil.
\v 13 Protože jste \it tam\it* předtím nebyli, Hospodin, náš Bůh, se na nás obořil, neboť jsme se ho nedotazovali na nařízení.
\v 14 Kněží a~lévité se posvětili, aby přenesli truhlu Hospodina, Boha Izraele.
\v 15 Synové Léviho nesli Boží truhlu tak, jak přikázal Mojžíš, podle Hospodinova slova: na svých ramenou na tyčích.
\p
\v 16 David řekl lévijským předákům, aby ustanovili své bratry zpěváky s~hudebními nástroji, harfami, lyrami a~zvučnými činely, aby pozvedli hlas s~radostí.
\v 17 A~lévité ustanovili Hémana, syna Jóelova, a~z~jeho bratrů Asafa, syna Berekjášova; ze synů Merarího, svých bratrů, Étana, syna Kúšajášova;
\v 18 a~s~nimi své druhořadé bratry: Zekarjáše, Jaazíela, Šemiramóta, Jechíela, Uniho, Elíaba, Benajáše, Maasejáše, Matitjáše, Elífelehúa, Miknejáše, Obéd‑edóma a~Jeíela vrátné;
\v 19 zpěváky: Hémana, Asafa a~Étana, aby zpívali s~bronzovými činely;
\v 20 Zekarjáše, Azíela, Šemiramóta, Jechíela, Uniho, Elíaba, Maasejáše a~Benajáše s~harfami na alamót,
\v 21 Matitjáše, Elífelehúa, Miknejáše, Obéd‑edóma, Jeíela, Azazjáše s~lyrami, aby vedli hudbu na šeminit.
\v 22 Kenanjáš, lévijský předák, při nošení řídil přenášení, neboť byl zručný.
\v 23 Berekjáš a~Elkána \it byli\it* vrátnými u~truhly.
\v 24 Kněží Šebanjáš, Jóšafat, Netanel, Amasaj, Zekarjáš, Benajáš a~Elíezer troubili na trubky před Boží truhlou. Obéd‑edóm a~Jechijáš \it byli\it* vrátnými u~truhly.
\p
\v 25 David, izraelští starší a~velitelé \it nad\it* tisíci šli, aby s~radostí přenesli truhlu Hospodinovy smlouvy z~domu Obéd‑edómova.
\v 26 Protože Bůh pomáhal lévitům, kteří nesli truhlu Hospodinovy smlouvy, obětovali sedm býčků a~sedm beranů.
\v 27 David byl zahalen pláštěm \it z\it*~jemného plátna, též všichni lévité, kteří nesli truhlu, zpěváci a~Kenanjáš, předák zpěváků přenášení; a~David \it měl\it* na \it sobě\it* lněný efód.
\v 28 Celý Izrael přenášel truhlu Hospodinovy smlouvy s~křikem a~za zvuku beraního rohu, trubek, zvučných činelů, harf a~lyr.
\v 29 I~stalo se, \it když\it* truhla Hospodinovy smlouvy vešla do Města Davidova, že Míkal, dcera Saulova, se rozhlížela z~okna a~uviděla krále Davida, \it jak\it* poskakuje a~raduje se; a~pohrdla jím ve svém srdci.
\c 16
\v 1 Přenesli Boží truhlu, postavili ji uprostřed stanu, který pro ni David postavil, a~přinášeli před Bohem zápalné a~pokojné oběti.
\v 2 Když David dokončil přinášení zápalných a~pokojných obětí, požehnal lidu v~Hospodinově jménu.
\v 3 Pak podělil všechny Izraelce, muže i~ženy, každému bochník chleba, datlový a~hrozinkový koláč.
\v 4 Nato ustanovil \it některé\it* z~lévitů před Hospodinovu truhlu \it jako\it* služebníky, aby vzdávali díky, chválili a~připomínali Hospodina, Boha Izraele:
\v 5 předáka Asafa, druhého \it po\it* něm Zekarjáše, Jeíela, Šemiramóta, Jechíela, Matitjáše, Elíaba, Benajáše, Obéd‑edóma a~Jeíela s~\it hudebními\it* nástroji, harfami a~lyrami a~Asafa se zvučnými činely
\v 6 a~kněze Benajáše a~Jachazíela s~trubkami, \it aby byli\it* ustavičně před truhlou Boží smlouvy.
\s1 Davidův chvalozpěv
\p
\v 7 Tehdy, v~onen den, David poprvé ustanovil, aby byly vzdávány díky Hospodinu prostřednictvím Asafa a~jeho bratrů:
\v 8 Vzdávejte chválu Hospodinu, vzývejte jeho jméno, oznamujte mezi národy jeho činy.
\v 9 Zpívejte mu, opěvujte jej, přemýšlejte o~všech jeho obdivuhodných \it činech\it*.
\v 10 Chlubte se jeho svatým jménem, \it ať\it* se raduje srdce těch, kdo hledají Hospodina.
\p
\v 11 Hledejte Hospodina a~jeho sílu, ustavičně vyhledávejte jeho tvář.
\p
\v 12 Pamatujte \it na\it* jeho obdivuhodné \it činy\it*, které učinil, \it na\it* jeho divy a~rozsudky jeho úst,
\v 13 potomci Izraele, jeho otroka, synové Jákobovi, jeho vyvolení.
\v 14 On \it je\it* Hospodin, náš Bůh, jeho rozhodnutí \it jsou\it* po celé zemi.
\v 15 Připomínejte navěky jeho smlouvu, slovo, \it které\it* přikázal tisíci pokolení;
\v 16 \it smlouvu\it*, kterou uzavřel s~Abrahamem, jeho přísahu Izákovi,
\v 17 potvrdil ji jako ustanovení Jákobovi, \it jako\it* smlouvu věčnou Izraeli.
\v 18 Řekl: Tobě dám kenaanskou zemi \it za\it* váš dědičný díl.
\p
\v 19 \it Na\it* počet vás byla malá hrstka, pobývali jste v~ní jako cizinci,
\v 20 přecházeli z~národa do národa, z~království do jiného lidu.
\v 21 Nedovolil nikomu, aby je utlačoval, káral kvůli nim krále:
\v 22 Nedotýkejte se mých pomazaných, mým prorokům neubližujte.
\p
\v 23 Zpívej Hospodinu, celá země, zvěstujte den za dnem jeho záchranu.
\v 24 Vypravujte mezi národy o~jeho slávě, mezi všemi lidmi \it o\it*~jeho obdivuhodných \it činech\it*.
\v 25 Vždyť Hospodin \it je\it* velký, nejvýš chvályhodný, obávaný nad všechny bohy.
\v 26 Vždyť všichni bohové národů \it jsou\it* nicotnosti, ale Hospodin učinil nebesa.
\v 27 Nádhera a~důstojnost \it je\it* před ním, síla a~radost na jeho místě.
\v 28 Vzdejte Hospodinu, čeledi národů, vzdejte Hospodinu slávu a~moc.
\v 29 Vzdejte Hospodinu slávu jeho jména, přineste dar, přijďte před něj, klaňte se Hospodinu v~slávě svatyně.
\p
\v 30 Svíjej se před ním, celá země. Ano, svět stojí pevně, nezhroutí se.
\v 31 \it Ať\it* se nebesa radují a~země \it ať\it* jásá; ať říkají mezi národy: Hospodin kraluje.
\v 32 \it Ať\it* burácí moře i~všechno, co je \it v\it*~něm; \it ať\it* se veselí pole i~všechno, co \it je\it* na něm.
\v 33 Tehdy budou lesní stromy radostně volat před Hospodinem, že přichází soudit zemi.
\p
\v 34 Vzdávejte Hospodinu díky, protože \it je\it* dobrý, jeho milosrdenství \it je\it* věčné.
\v 35 Říkejte: Zachraň nás, Bože, náš zachránče, shromáždi nás a~vysvoboď nás z~národů, abychom vzdávali díky tvému svatému jménu a~uctívali tvou chválu.
\v 36 Požehnán buď Hospodin, Bůh Izraele, od věků až navěky. A~všechen lid řekl: Amen. Chvalte Hospodina.
\p
\v 37 Tam před truhlou Hospodinovy smlouvy zanechal Asafa a~jeho bratry, aby sloužili před truhlou ustavičně podle každodenního určení;
\v 38 dále Obéd‑edóma a~jeho šedesát osm bratrů, Obéd‑edóma, syna Jedútúnova, a~Chosu jako vrátné;
\v 39 kněze Sádoka a~jeho bratry kněze před Hospodinovým příbytkem na návrší, které \it je\it* v~Gibeónu,
\v 40 aby přinášeli zápalné oběti Hospodinu na oltáři \it pro\it* zápalné oběti ustavičně, ráno i~večer, podle všeho, co je zapsáno v~Hospodinově zákoně, který přikázal Izraeli.
\v 41 S~nimi \it byli\it* také Héman, Jedútún a~ostatní vybraní, kteří byli jmenovitě určeni, aby vzdávali Hospodinu díky, protože jeho milosrdenství \it je\it* věčné.
\v 42 Héman a~Jedútún \it měli\it* s~sebou trubky, zvučné činely a~nástroje \it pro\it* písně Bohu; synové Jedútúnovi \it byli\it* v~bráně.
\v 43 Potom všechen lid odešel, každý domů, a~David se vrátil, aby požehnal svému domu.
\c 17
\s1 Dům Hospodinův a~dům Davidův
\p
\v 1 I~stalo se, když David sídlil ve svém domě, že řekl proroku Nátanovi: Hle, já sídlím v~cedrovém domě a~truhla Hospodinovy smlouvy \it je\it* pod stanovou plachtou.
\v 2 Nátan Davidovi odpověděl: Učiň vše, co \it máš\it* na srdci, protože Bůh \it je\it* s~tebou.
\p
\v 3 Oné noci se však stalo Boží slovo k~Nátanovi:
\v 4 Jdi a~řekni mému otroku Davidovi: Toto praví Hospodin: Ty mi nestav dům, abych \it v~něm\it* sídlil.
\v 5 Vždyť jsem nesídlil v~domě od toho dne, kdy jsem Izrael vyvedl, až do tohoto dne, ale \it přecházel\it* jsem ze stanu do stanu a~z~příbytku \it do příbytku\it*.
\v 6 \it Ať\it* jsem s~celým Izraelem přecházel kudykoli, řekl jsem snad některému \it ze\it* soudců Izraele, jež jsem ustanovil, aby pásli můj lid: Proč mi nepostavíte cedrový dům?
\p
\v 7 Nuže, toto pověz mému otroku Davidovi: Toto praví Hospodin zástupů: Vzal tě z~pastvin, od \it chovu\it* ovcí, abys byl vévodou nad mým lidem Izraelem.
\v 8 Byl jsem s~tebou, kamkoli jsi šel, a~vyhladil jsem před tebou všechny tvé nepřátele. Učiním tvé jméno, jako \it je\it* jméno velikánů na zemi.
\v 9 Nachystám pro svůj lid Izrael území, zasadím ho, bude bydlet na svém místě a~nebude se již třást. Bídáci ho již nebudou odírat jako dříve,
\v 10 ode dnů, kdy jsem ustanovil soudce nad svým lidem Izraelem; pokořím všechny tvé nepřátele. Oznamuji ti, že dům ti postaví Hospodin.
\p
\v 11 I stane se, až se naplní tvé dny, abys šel ke svým otcům, dám povstat tvému potomku po tobě, který bude ze tvých synů, a~upevním jeho království.
\v 12 On mi postaví dům a~já upevním jeho trůn navěky.
\v 13 Já budu jeho otcem a~on bude mým synem. Své milosrdenství od něj neodejmu, tak jak jsem \it je\it* odňal od toho, který byl před tebou.
\v 14 Ustanovím ho ve svém domě a~ve svém království navěky a~jeho trůn bude pevně stát navěky.
\v 15 Všechna tato slova a~celé toto vidění pověděl Nátan Davidovi.
\s1 Davidova modlitba
\p
\v 16 Nato král David vešel, posadil se před Hospodinem a~řekl: Kdo \it jsem\it* já, Hospodine Bože, a~co \it je\it* můj dům, že jsi mě přivedl až sem?
\v 17 I~toto bylo ve tvých očích málo, Bože, a~promluvil jsi o~domě svého otroka do vzdálené \it budoucnosti\it*. Ukázal jsi mi, co člověk touží poznat, Hospodine Bože.
\v 18 Co ti \it může\it* David ještě dále \it říct\it* o~slávě tvého otroka? Ty svého otroka znáš.
\v 19 Hospodine, kvůli svému otroku a~podle svého srdce jsi učinil všechny tyto velké \it věci\it* a~dal jsi \it mu\it* poznat všechny tyto velké \it skutečnosti\it*.
\v 20 Hospodine, není \it nikdo\it* jako ty, není Bůh kromě tebe – tak, jak jsme na vlastní uši slyšeli.
\v 21 A~kdo \it je\it* jako tvůj lid Izrael, jediný národ na zemi, který si šel Bůh vykoupit \it za\it* lid, a~učinil si jméno velkými a~hrůzu vzbuzujícími \it činy\it*, když jsi vyhnal národy před svým lidem, který sis vykoupil z~Egypta.
\v 22 Učinil sis svůj lid Izrael navěky svým lidem a~ty, Hospodine, ses stal jejich Bohem.
\p
\v 23 A nyní, Hospodine, slovo, které jsi promluvil o~svém otroku a~o~jeho domu, \it ať\it* se ukáže jako spolehlivé navěky. Učiň, jak jsi prohlásil.
\v 24 A~jako spolehlivé a~velké \it ať\it* se ukáže tvé jméno navěky, když budou říkat: Hospodin zástupů, Bůh Izraele, \it je\it* Bohem Izraele. A~dům tvého otroka Davida bude pevně stát před tebou.
\v 25 Vždyť ty, můj Bože, jsi odhalil uchu svého otroka, že mu postavíš dům. Proto našel tvůj otrok \it odvahu\it* modlit se před tebou.
\v 26 Nyní, Hospodine, ty jsi Bůh a~promluvil jsi o~svém otroku tyto dobré \it věci\it*.
\v 27 Nyní jsi ráčil požehnat domu svého otroka, aby byl navěky před tebou. Když ty jsi Hospodine požehnal, bude požehnán navěky.
\c 18
\s1 Davidova vítězství
\p
\v 1 Potom se stalo, že David pobil Pelištejce, pokořil je a~vzal od Pelištejců Gat a~jeho vesnice.
\v 2 Pobil i~Moábce a~Moábci se stali Davidovými otroky \it a\it*~přinášeli dávky.
\v 3 David pobil také Hadad‑ezera, krále Sóby, v~Chamátu, když táhl upevnit svou moc u~řeky Eufratu.
\v 4 David mu zajal tisíc vozů, sedm tisíc jezdců a~dvacet tisíc pěšáků. David ochromil všechny \it koně k\it*~vozům a~ponechal mu \it koně jen ke\it* stu vozů.
\p
\v 5 Aramejci z~Damašku přitáhli Hadad‑ezerovi, králi Sóby, na pomoc, ale David pobil z~Aramejců dvacet dva tisíc mužů.
\v 6 Pak David umístil mezi Aramejce z~Damašku \it posádku\it*, Aramejci se stali Davidovými otroky \it a\it*~přinášeli dávky. Hospodin Davidovi pomáhal, kamkoli šel.
\v 7 David vzal zlaté štíty, které měli Hadad‑ezerovi otroci, a~přinesl je \it do\it* Jeruzaléma.
\v 8 Z~Tibchatu a~Kúnu, Hadad‑ezerových měst, vzal David velmi mnoho bronzu, z~něhož Šalomoun udělal bronzové moře, sloupy a~bronzové předměty.
\p
\v 9 Když se Toú, král Chamátu, doslechl, že David pobil celé vojsko Hadad‑ezera, krále Sóby,
\v 10 poslal ke králi Davidovi svého syna Hadoráma, aby se ho zeptal, jak se \it mu\it* daří, a~poblahopřál mu, že bojoval proti Hadad‑ezerovi a~zabil ho. Toú totiž \it s\it*~Hadad‑ezerem vedl války. \it Hadorám s~sebou přinesl\it* všelijaké zlaté, stříbrné a~bronzové předměty.
\v 11 Také ty král David zasvětil Hospodinu spolu se stříbrem a~zlatem, které přinesl ze všech národů: od Edómců, Moábců, synů Amónových, od Pelištejců a~Amálekovců.
\p
\v 12 Abíšaj, syn Serújin, pobil v~Solném údolí osmnáct tisíc Edómců.
\v 13 Umístil v~Edómu posádky a~všichni Edómci se stali Davidovými otroky. Hospodin Davidovi pomáhal, kamkoli šel.
\p
\v 14 David kraloval nad celým Izraelem a~vykonával právo a~spravedlnost nad vším svým lidem.
\v 15 Jóab, syn Serújin, \it byl\it* nad armádou, Jóšafat, syn Achílúdův, \it byl\it* kancléřem,
\v 16 Sádok, syn Achítúbův, a~Abímelek, syn Ebjátarův, \it byli\it* kněžími, Šavša \it byl\it* písařem,
\v 17 Benajáš, syn Jójadův, \it byl\it* nad Keretejci a~Peletejci a~Davidovi synové \it byli\it* králi první k~ruce.
\c 19
\s1 David poráží Amónce
\p
\v 1 Potom se stalo, že zemřel Náchaš, král synů Amónových, a~po něm se stal králem jeho syn.
\v 2 David si řekl: Prokážu milosrdenství Chanúnovi, synu Náchašovu, neboť jeho otec prokázal milosrdenství mně. A~tak David poslal posly, aby mu poskytl útěchu nad jeho otcem. Když přišli Davidovi otroci do země synů Amónových k~Chanúnovi, aby mu poskytli útěchu,
\v 3 knížata synů Amónových řekla Chanúnovi: Připadá ti, \it že\it* chce uctít tvého otce, když ti poslal utěšitele? Což k~tobě jeho otroci nepřišli, jen aby důkladně prohlédli, vyvrátili a~prozkoumali zemi?
\v 4 Chanún vzal Davidovy otroky, oholil je, odřízl polovinu jejich roucha až po zadek a~poslal je pryč.
\v 5 Kdosi šel a~pověděl o~těch mužích Davidovi. On jim poslal naproti, protože ti muži byli velice zhanobeni. Král řekl: Zůstaňte v~Jerichu, dokud vám vousy nedorostou, a~pak se vraťte.
\p
\v 6 Synové Amónovi viděli, že se Davidovi znelíbili. Proto Chanún a~synové Amónovi poslali tisíc talentů stříbra, aby si z~Aramského Dvojříčí, z~Aramské Maaky a~ze Sóby najali vozy a~jezdce.
\v 7 Najali si třicet dva tisíc vozů, krále Maaky a~jeho lid. Vytáhli a~utábořili se před Médebou. Synové Amónovi se shromáždili ze svých měst a~vytáhli do boje.
\p
\v 8 Když se \it to\it* doslechl David, poslal Jóaba a~celou armádu hrdinů.
\v 9 Synové Amónovi vytáhli a~sešikovali se \it k\it*~boji \it u\it*~vchodu \it do\it* města. Ale králové, kteří přitáhli, \it byli\it* zvlášť, na poli.
\v 10 Když Jóab viděl, že je proti němu boj \it z\it*předu i~zezadu, vybral všechny vybrané \it muže\it* z~Izraele a~sešikoval se proti Aramejcům.
\v 11 Zbytek lidu dal pod velení svého bratra Abíšaje, aby se sešikovali proti synům Amónovým.
\v 12 Řekl: Jestliže budou Aramejci silnější nežli já, přijdeš mi na pomoc. A~jestliže budou synové Amónovi silnější nežli ty, pomůžu \it já\it* tobě.
\v 13 Buď silný a~počínejte si zmužile za svůj lid a~za města našeho Boha. A~Hospodin \it ať\it* učiní, co \it je\it* dobré v~jeho očích.
\v 14 Jóab a~lid, který \it byl\it* s~ním, se pustil do boje proti Aramejcům, ale \it ti\it* před ním utekli.
\v 15 Když synové Amónovi viděli, že Aramejci utíkají, také oni před jeho bratrem Abíšajem utekli a~vešli do města. Jóab šel \it do\it* Jeruzaléma.
\p
\v 16 Když Aramejci viděli, že byli od Izraele poraženi, poslali posly a~nechali přivést Aramejce, kteří \it byli\it* v~Zaeufratí. V~jejich čele \it byl\it* Šófak, velitel Hadad‑ezerovy armády.
\v 17 Když \it to\it* bylo Davidovi oznámeno, shromáždil celý Izrael, přešel Jordán, vytáhl proti nim a~sešikoval se proti nim. David se sešikoval proti Aramejcům \it do\it* boje a~\it oni\it* s~ním bojovali.
\v 18 Aramejci však před Izraelem utekli. David zabil sedm tisíc aramejských voza\it tajů\it* a~čtyřicet tisíc pěšáků. Usmrtil i~velitele armády Šófaka.
\v 19 Když Hadad‑ezerovi otroci viděli, že byli od Izraele poraženi, uzavřeli s~Davidem mír a~sloužili mu. Aramejci již nechtěli synům Amónovým pomáhat.
\c 20
\s1 Dobytí Raby
\p
\v 1 I~stalo se na přelomu roku, v~době, \it kdy\it* králové táhnou \it do boje\it*, že Jóab vedl vojenské síly a~ničil zemi synů Amónových. Přitáhl a~oblehl Rabu, zatímco David zůstal v~Jeruzalémě. Jóab Rabu přepadl a~zbořil ji.
\v 2 David vzal korunu jejich krále z~jeho hlavy; shledal, \it že\it* váží talent zlata a~\it byl\it* na ní drahokam. Spočinula na Davidově hlavě. Vynesl \it z\it*~města velmi mnoho kořisti.
\v 3 Lid, který v~něm \it byl\it*, vyvedl a~ustanovil, \it aby pracovali\it* s~pilou, železnými špičáky a~sekerami. Tak jednal David se všemi městy synů Amónových. David a~všechen lid se pak vrátil \it do\it* Jeruzaléma.
\s1 Boje s~Pelištejci
\p
\v 4 Potom se stalo, že vypukl boj s~Pelištejci v~Gezeru. Tehdy Sibekaj Chúšatský ubil Sipaje z~rodu Refájců a~byli pokořeni.
\v 5 Znovu došlo \it k\it*~boji s~Pelištejci a~Elchánan, syn Jaírův, ubil Lachmího, bratra Goliáše Gatského. Násada jeho kopí \it byla\it* jako tkalcovské vratidlo.
\v 6 Znovu došlo \it k\it*~boji v~Gatu. Byl \it tam\it* obrovitý muž, \it který\it* měl po šesti prstech, \it celkem\it* dvacet čtyři. Také on se narodil Refájcům.
\v 7 Když tupil Izrael, ubil ho Jónatan, syn Davidova bratra Šimey.
\v 8 Ti se narodili Refájcům v~Gatu. Padli rukou Davida a~rukou jeho otroků.
\c 21
\s1 David sčítá lid
\p
\v 1 Satan povstal proti Izraeli a~navedl Davida, aby spočítal Izrael.
\v 2 David řekl Jóabovi a~knížatům lidu: Jděte \it a\it*~spočítejte Izrael od Beer‑šeby až po Dan a~přineste mi \it zprávu\it*, ať vím, kolik jich \it je\it*.
\v 3 Jóab řekl: \it Ať\it* Hospodin přidá ke svému lidu stokrát \it víc\it*, než ho \it je\it*. Což nejsou, můj pane \it a\it*~králi, všichni otroky mého pána? Proč to chce můj pán \it udělat\it*? Proč by měla být na Izraeli vina?
\v 4 Královo slovo však bylo vůči Jóabovi pevné. Jóab tedy vyšel, procházel celým Izraelem a~vrátil se \it do\it* Jeruzaléma.
\v 5 Jóab udal Davidovi počet sečteného lidu. Všech Izraelců byl milion sto tisíc mužů tasících meč a~Judejců \it bylo\it* čtyři sta sedmdesát tisíc mužů tasících meč.
\v 6 Mezi Lévijci a~Benjamínci nepočítal, protože Jóabovi se královo slovo ošklivilo.
\v 7 Ta věc byla zlá v~Božích očích a~ranil Izrael.
\p
\v 8 Nato David řekl Bohu: Velmi jsem zhřešil, že jsem to udělal. Nyní odejmi, prosím, vinu svého otroka, neboť jsem jednal velice bláznivě.
\p
\v 9 Hospodin promluvil ke Gádovi, Davidovu vidoucímu:
\v 10 Jdi a~promluv k~Davidovi: Toto praví Hospodin: Předkládám ti tři \it věci\it*. Vyber si jednu z~nich, kterou ti \it mám\it* udělat.
\v 11 Gád přišel k~Davidovi a~řekl mu: Toto praví Hospodin: Vyber si:
\v 12 Tři roky hladu nebo tři měsíce být ničen svými protivníky, kdy by \it tě\it* stíhal meč tvých nepřátel, anebo tři dny Hospodinova meče a~moru v~zemi, kdy by Hospodinův anděl působil zkázu po celém území Izraele. Nyní se rozhodni, co \it mám\it* odpovědět tomu, kdo mě poslal.
\v 13 David Gádovi odpověděl: Jsem \it ve\it* veliké tísni. Kéž padnu do Hospodinovy ruky, neboť jeho slitování \it je\it* velké. \it Jenom\it* ať nepadnu do ruky člověka.
\v 14 Hospodin na Izrael uvedl mor a~padlo z~Izraele sedmdesát tisíc mužů.
\v 15 Bůh poslal do Jeruzaléma anděla, aby ho ničil. A~když ničil, Hospodin \it to\it* viděl, litoval toho zla a~řekl andělu, který působil zkázu: Dost. Nyní odtáhni svou ruku. A~Hospodinův anděl se zastavil u~humna Ornána Jebúsejského.
\p
\v 16 David pozvedl oči a~uviděl Hospodinova anděla, \it jak\it* stojí mezi zemí a~nebem a~v~ruce má tasený meč, vztažený nad Jeruzalémem. David i~starší přikrytí pytlovinou padli na tvář.
\v 17 David řekl Bohu: Což jsem neřekl já, aby byl sečten lid? Já jsem zhřešil a~spáchal velké zlo. Ale tyto ovce, co provedly? Hospodine, můj Bože, ať je tvá ruka proti mně a~proti domu mého otce, ale na tvůj lid \it ať\it* ne\it dopadne\it* rána.
\p
\v 18 Hospodinův anděl řekl Gádovi, aby řekl Davidovi: Ať David jde a~postaví Hospodinu oltář na humně Ornána Jebúsejského.
\v 19 David šel podle Gádova slova, které promluvil v~Hospodinově jménu.
\v 20 Když se Ornán obrátil, uviděl toho anděla. Jeho čtyři synové, \it kteří byli\it* s~ním, se skrývali. Ornán mlátil pšenici.
\v 21 David přišel až k~Ornánovi. Když se Ornán ohlédl, uviděl Davida, vyšel z~humna a~klaněl se Davidovi tváří k~zemi.
\v 22 David řekl Ornánovi: Dej mi místo, \it na kterém je\it* humno, abych na něm \it mohl\it* postavit Hospodinu oltář. Dej mi ho za plnou \it cenu\it* stříbra, aby byla rána od lidu zadržena.
\v 23 Ornán řekl Davidovi: Vezmi si \it to\it*. Ať můj pán \it a\it*~král udělá, co \it je\it* mu libo. Pohleď, dám skot pro zápalnou oběť, smyky na dříví a~pšenici pro přídavnou oběť. To všechno dám.
\v 24 Král David řekl Ornánovi: Ne! Chci \it to\it* koupit za plnou \it cenu\it* stříbra. Vždyť ne\it mohu\it* přinést Hospodinu to, co \it je\it* tvé, či přinést zápalnou oběť \it získanou\it* zadarmo.
\v 25 A~David dal Ornánovi za \it to\it* místo šest set šekelů váhy zlata.
\p
\v 26 Pak tam David postavil Hospodinu oltář a~přinesl zápalné a~pokojné oběti. Volal k~Hospodinu a~\it on\it* mu odpověděl ohněm z~nebe, \it seslaným\it* na oltář pro zápalné oběti.
\v 27 Hospodin řekl andělovi, aby vrátil svůj meč do pochvy.
\v 28 V~oné době, když David viděl, že mu Hospodin odpověděl na humně Ornána Jebúsejského, obětoval tam.
\v 29 Hospodinův příbytek, který udělal Mojžíš v~pustině, i~oltář pro zápalné oběti \it byl\it* v~oné době na návrší v~Gibeónu.
\v 30 Ale David nemohl jít před něj hledat Boha, protože se děsil meče Hospodinova anděla.
\c 22
\v 1 David řekl: Toto bude dům Hospodina Boha a~toto \it bude\it* oltář pro zápalné oběti pro Izrael.
\s1 Přípravy k~stavbě chrámu
\p
\v 2 David přikázal, aby shromáždili cizince, kteří \it jsou\it* v~izraelské zemi, a~ustanovil kameníky, aby tesali kameny tesané \it na míru\it* pro stavbu Božího domu.
\v 3 David připravil též množství železa na hřebíky pro vrata bran a~na skoby a~bronzu takové množství, \it že se\it* ne\it dalo\it* zvážit,
\v 4 a~cedrového dřeva, \it že se\it* ne\it dalo\it* spočítat, neboť Sidóňané a~Týřané Davidovi přiváželi množství cedrového dřeva.
\p
\v 5 David si řekl: Můj syn Šalomoun \it je\it* mladý a~útlý a~dům, který se \it má\it* postavit Hospodinu, musí být zvlášť veliký, aby \it byl\it* věhlasný a~slavný po všech zemích. Musím pro něj udělat přípravy. A~David připravil před svou smrtí množství \it materiálu\it*.
\v 6 Potom zavolal svého syna Šalomouna a~přikázal mu, aby postavil dům pro Hospodina, Boha Izraele.
\p
\v 7 David Šalomounovi řekl: Můj synu, měl jsem na srdci postavit dům pro jméno Hospodina, svého Boha.
\v 8 Ale stalo se ke mně Hospodinovo slovo: Prolil jsi mnoho krve a~vedl jsi velké války. Nestav dům pro mé jméno, neboť jsi přede mnou prolil mnoho krve na zem.
\v 9 Hle, narodí se ti syn. On bude mužem odpočinutí. Jemu dám odpočinek od všech jeho okolních nepřátel. Vždyť se bude jmenovat Šalomoun. V~jeho dnech dám na Izrael pokoj a~klid.
\v 10 On postaví dům pro mé jméno. On bude mým synem a~já \it budu\it* jeho otcem. Jeho královský trůn nad Izraelem upevním navěky.
\p
\v 11 Nyní, můj synu, ať je Hospodin s~tebou. Ať uspěješ a~postavíš dům Hospodinu, svému Bohu, jak o~tobě promluvil.
\v 12 Jen \it ať\it* ti Hospodin dá rozumnost a~porozumění a~ustanoví tě nad Izraelem, abys zachovával zákon Hospodina, svého Boha.
\v 13 Tehdy uspěješ, jestliže budeš zachovávat a~plnit ustanovení a~nařízení, která Hospodin přikázal Mojžíšovi pro Izrael. Posilni se a~buď odvážný, neboj se a~neděs se.
\p
\v 14 Hle, ve svém soužení jsem pro Hospodinův dům připravil sto tisíc talentů zlata, milion talentů stříbra a~takové množství bronzu a~železa, \it že se\it* ne\it dá\it* zvážit. Také dřevo a~kámen jsem připravil a~\it ty\it* k~nim přidej.
\v 15 \it Je\it* u~tebe množství dělníků: lamači, kameníci a~tes\it aři\it* a~všelijací zruční \it řemeslníci\it* pro každou práci.
\v 16 Zlata, stříbra, bronzu a~železa \it je\it* bezpočet. Povstaň a~jednej a~Hospodin ať je s~tebou.
\p
\v 17 A David přikázal všem izraelským knížatům, aby jeho synu Šalomounovi pomáhali:
\v 18 Což není Hospodin, můj Bůh, s~vámi a~\it ne\it*dal vám odpočinek všude kolem? Vždyť vydal obyvatele země do mé ruky a~země je podmaněna před Hospodinem a~před jeho lidem.
\v 19 Nyní přiložte své srdce a~svou duši k~hledání Hospodina, svého Boha. Povstaňte a~stavte svatyni Hospodina Boha, aby byla přenesena truhla Hospodinovy smlouvy a~posvátné Boží předměty do domu postaveného pro Hospodinovo jméno.
\c 23
\s1 Rozdělení lévitů
\p
\v 1 Když David zestárl a~byl sytý dnů, ustanovil králem nad Izraelem svého syna Šalomouna.
\v 2 Shromáždil všechna izraelská knížata, kněze a~lévity.
\v 3 Spočítali lévity od věku třiceti let výše a~jejich počet, \it hlava\it* za hlavou, byl třicet osm tisíc mužů.
\v 4 Z~nich \it bylo\it* dvacet čtyři tisíc vedoucích nad službou Hospodinova domu, šest tisíc správců a~soudců,
\v 5 čtyři tisíce vrátných a~čtyři tisíce chválících Hospodina na nástroje, které jsem udělal pro chválení.
\v 6 David je rozdělil \it po\it* skupinách podle synů Léviho, Geršóna, Kehata a~Merarího.
\p
\v 7 Ke Geršónovcům: Laedán a~Šimeí.
\p
\v 8 Synové Laedánovi: předák Jechíel, Zétam a~Jóel, \it tito\it* tři.
\p
\v 9 Synové Šimeího: Šelomít, Chazíel a~Háran, \it tito\it* tři. To \it byli\it* předáci Laedánových rodů.
\p
\v 10 Synové Šimeího: Jachat, Zína, Jeúš a~Bería. To \it byli\it* čtyři synové Šimeího.
\v 11 Jachat byl předákem, Zíza druhý. Jeúš a~Bería neměli mnoho synů, byli \it bráni\it* jako jeden otcovský dům, s~\it jednou\it* povinností.
\p
\v 12 Synové Kehatovi: Amrám, Jishár, Chebrón a~Uzíel, \it tito\it* čtyři.
\p
\v 13 Synové Amrámovi: Áron a~Mojžíš. Áron byl oddělen, aby posvěcoval nejsvětější věci, on i~jeho synové navěky, aby pálili kadidlo před Hospodinem, sloužili mu a~žehnali v~jeho jménu navěky.
\p
\v 14 Co se týče Mojžíše, muže Božího, jeho synové byli jmenováni u~kmene Léviho.
\v 15 Synové Mojžíšovi: Geršóm a~Elíezer.
\v 16 Synové Geršómovi: předák Šebúel.
\v 17 Synové Elíezerovi byli: předák Rechabjáš. Elíezer neměl další syny, ale synů Rechabjášových bylo velmi mnoho.
\p
\v 18 Synové Jishárovi: předák Šelomít.
\v 19 Synové Chebrónovi: předák Jerijáš, druhý Amarjáš, třetí Jachazíel a~čtvrtý Jekameám.
\v 20 Synové Uzíelovi: předák Míka, druhý Jišijáš.
\p
\v 21 Synové Merarího: Machlí a~Muší. Synové Machlího: Eleazar a~Kíš.
\v 22 Eleazar zemřel a~neměl syny, jenom dcery. A~tak si je vzali synové Kíšovi, jejich příbuzní.
\v 23 Synové Mušího: Machlí, Eder a~Jeremót, \it tito\it* tři.
\p
\v 24 Toto \it jsou\it* synové Léviho podle domu svých otců, předáci rodů, jak byli spočítáni podle počtu jmen, \it hlava\it* za hlavou, ti, kteří konali práci služby Hospodinova domu od věku dvaceti let výše.
\v 25 Neboť David řekl: Hospodin, Bůh Izraele, dal odpočinek svému lidu a~bude navěky přebývat v~Jeruzalémě.
\v 26 A~tak nemusejí lévité nosit příbytek ani všechny předměty pro jeho službu.
\v 27 Neboť podle Davidových posledních slov byli synové Léviho počítáni od věku dvacet let výše.
\p
\v 28 Jejich stanoviště \it bylo\it* vedle synů Áronových v~službě Hospodinova domu – \it byli\it* nad nádvořími, komorami, nad očišťováním všech svatých věcí a~dílem služby Božího domu,
\v 29 nad předkladným chlebem, jemnou moukou pro přídavné oběti, plackami nekvašených chlebů, plochými pánvemi, mísením a~všemi odměrkami \it objemu\it* a~mírami \it délky\it*;
\v 30 ráno co ráno stáli a~vzdávali díky a~chválili Hospodina a~tak i~večer
\v 31 i~při každém přinášení zápalných obětí Hospodinu, o~sobotách, novoluních a~svátcích podle počtu nařízeného pro ně, ustavičně před Hospodinem.
\v 32 Konali tedy službu \it u\it*~stanu setkávání, službu \it u\it*~svatyně a~službu \it u\it*~synů Áronových, svých bratrů, při službě Hospodinova domu.
\c 24
\s1 Rozdělení kněží
\p
\v 1 \it Toto\it* byly skupiny synů Áronových: Synové Áronovi: Nádab a~Abíhú, Eleazar a~Ítamar.
\v 2 Nádab a~Abíhú zemřeli před svým otcem a~neměli syny, takže jako kněží sloužili Eleazar a~Ítamar.
\v 3 David se Sádokem ze synů Eleazarových a~Achímelekem ze synů Ítamarových je rozdělili podle jejich služebních povinností.
\v 4 Shledalo se, \it že\it* synů Eleazarových \it je\it* více předních mužů nežli synů Ítamarových, a~tak synům Eleazarovým přidělili šestnáct předáků podle domu otců a~synům Ítamarovým osm podle domu jejich otců.
\v 5 Přidělili je losy, ty i~ony, neboť byli předáky svatyně a~předáky Božími ze synů Eleazarových i~ze synů Ítamarových.
\p
\v 6 Zapsal je písař Šemajáš, syn Netanelův, z~lévitů, před králem, knížaty, knězem Sádokem a~Achímelekem, synem Ebjátarovým, a~předáky kněžských a~lévijských rodů – \it vždy\it* jeden otcovský dům byl vytažen pro Eleazara a~jeden byl vytažen pro Ítamara.
\p
\v 7 První los padl na Jójaríba, druhý na Jedajáše,
\v 8 třetí na Charima, čtvrtý na Seórima,
\v 9 pátý na Malkijáše, šestý na Mijamína,
\v 10 sedmý na Hakóse, osmý na Abijáše,
\v 11 devátý na Jéšuu, desátý na Šekanjáše,
\v 12 jedenáctý na Eljašíba, dvanáctý na Jakíma,
\v 13 třináctý na Chupu, čtrnáctý na Ješebába,
\v 14 patnáctý na Bilgu, šestnáctý na Imera,
\v 15 sedmnáctý na Chezíra, osmnáctý na Hapisesa,
\v 16 devatenáctý na Petachjáše, dvacátý na Ezechiele,
\v 17 dvacátý první na Jakína, dvacátý druhý na Gamúla,
\v 18 dvacátý třetí na Delajáše \it a\it*~dvacátý čtvrtý na Maazjáše.
\p
\v 19 Toto \it jsou\it* jejich služební povinnosti, jak \it měli\it* přicházet do Hospodinova domu podle nařízení \it daného\it* jim prostřednictvím jejich otce Árona, jak mu přikázal Hospodin, Bůh Izraele.
\p
\v 20 Zbývající synové Léviho: ze synů Amrámových: Šúbael, ze synů Šúbaelových: Jechdejáš;
\v 21 z~Rechabjáše, ze synů Rechabjášových: předák Jišijáš;
\v 22 z~Jishárců: Šelomót, ze synů Šelomótových: Jachat;
\v 23 synové \it Chebrónovi: předák\it* Jerijáš, druhý Amarjáš, třetí Jachazíel, čtvrtý Jekameám;
\v 24 synové Uzíelovi: Míka, ze synů Míkových: Šamír;
\v 25 Míkův bratr: Jišijáš, ze synů Jišijášových: Zekarjáš;
\v 26 synové Merarího: Machlí a~Muší; synové Jaazijáše, jeho syna;
\v 27 synové Merarího z~jeho syna Jaazijáše: Šóham, Zakúr a~Ibrí;
\v 28 z~Machlího: Eleazar, který neměl syny;
\v 29 z~Kíše, synové Kíšovi: Jerachmeel;
\v 30 synové Mušího: Machlí, Eder a~Jerímót. Toto \it jsou\it* synové Léviho podle domu jejich otců.
\v 31 Také oni nechali padnout losy jako jejich bratři, synové Áronovi, před králem Davidem, Sádokem a~Achímelekem, předáky kněžských a~lévijských rodů, předákovi rodů stejně jako jeho nejmladšímu bratru.
\c 25
\s1 Chrámoví zpěváci
\p
\v 1 David s~veliteli armády oddělil pro službu syny Asafovy, Hémanovy a~Jedútúnovy, aby prorokovali s~lyrami, s~harfami a~činely. Výčet těch, kteří \it konali\it* dílo podle své služby, byl:
\p
\v 2 Ze synů Asafových: Zakúr, Josef, Netanjáš a~Asaréla. Synové Asafovi \it byli\it* pod vedením Asafa, který prorokoval pod vedením krále.
\p
\v 3 Z Jedútúna, synové Jedútúnovi: Gedaljáš, Serí, Izajáš, Chašabjáš a~Matitjáš, \it celkem\it* šest, pod vedením svého otce Jedútúna, který prorokoval s~lyrou za vzdávání díků a~chválení Hospodina.
\p
\v 4 Z Hémana, synové Hémanovi: Bukijáš, Matanjáš, Uzíel, Šebúel, Jerímót, Chananjáš, Chananí, Elíata, Gidaltí, Rómamtí‑ezer, Jošbekáša, Malótí, Hótír \it a\it*~Machazíót.
\v 5 Všichni tito \it byli\it* synové Hémana, králova vidoucího, podle Božích slov, aby byl pozdvižen \it jeho\it* roh. Bůh dal Hémanovi čtrnáct synů a~tři dcery.
\v 6 Ti všichni \it byli\it* pod vedením svého otce pro zpěv \it v\it*~Hospodinově domě s~činely, harfami a~lyrami, pro službu Božího domu. Asaf, Jedútún a~Héman \it byli\it* pod vedením krále.
\v 7 Jejich počet spolu s~jejich bratry vycvičenými \it ve\it* zpěvu Hospodinu, samí zkušení \it muži\it*, byl dvě stě osmdesát osm.
\v 8 Losy \it pro\it* službu nechali padnout jak pro malé, tak i~velké, zkušené i~učedníky.
\p
\v 9 První los padl pro Asafa na Josefa; druhý \it na\it* Gedaljáše, \it na\it* něj, jeho bratry a~syny, dvanáct;
\v 10 třetí \it na\it* Zakúra, jeho syny a~bratry, dvanáct;
\p
\v 11 čtvrtý na Jisrího, jeho syny a~bratry, dvanáct;
\p
\v 12 pátý \it na\it* Netanjáše, jeho syny a~bratry, dvanáct;
\p
\v 13 šestý \it na\it* Bukijáše, jeho syny a~bratry, dvanáct;
\p
\v 14 sedmý \it na\it* Jesarélu, jeho syny a~bratry, dvanáct;
\p
\v 15 osmý \it na\it* Izajáše, jeho syny a~bratry, dvanáct;
\p
\v 16 devátý \it na\it* Matanjáše, jeho syny a~bratry, dvanáct;
\p
\v 17 desátý \it na\it* Šimeího, jeho syny a~bratry, dvanáct;
\p
\v 18 jedenáctý \it na\it* Azarela, jeho syny a~bratry, dvanáct;
\p
\v 19 dvanáctý na Chašabjáše, jeho syny a~bratry, dvanáct;
\p
\v 20 třináctý \it na\it* Šebúela, jeho syny a~bratry, dvanáct;
\p
\v 21 čtrnáctý \it na\it* Matitjáše, jeho syny a~bratry, dvanáct;
\p
\v 22 patnáctý na Jeremóta, jeho syny a~bratry, dvanáct;
\p
\v 23 šestnáctý na Chananjáše, jeho syny a~bratry, dvanáct;
\p
\v 24 sedmnáctý na Jošbekášu, jeho syny a~bratry, dvanáct;
\p
\v 25 osmnáctý na Chananího, jeho syny a~bratry, dvanáct;
\p
\v 26 devatenáctý na Malótího, jeho syny a~bratry, dvanáct;
\p
\v 27 dvacátý na Elíatu, jeho syny a~bratry, dvanáct;
\p
\v 28 dvacátý první na Hótíra, jeho syny a~bratry, dvanáct;
\p
\v 29 dvacátý druhý na Gidaltího, jeho syny a~bratry, dvanáct;
\p
\v 30 dvacátý třetí na Machazíóta, jeho syny a~bratry, dvanáct;
\p
\v 31 dvacátý čtvrtý na Rómamtí‑ezera, jeho syny a~bratry, dvanáct.
\c 26
\s1 Vrátní
\p
\v 1 Ke skupinám vrátných patřili: z~Kórachovců: Mešelemjáš, syn Kórého, ze synů Asafových.
\v 2 Mešelemjáš měl syny: prvorozeného Zekarjáše, druhého Jedíaela, třetího Zebadjáše, čtvrtého Jatníela,
\v 3 pátého Élama, šestého Jóchanana \it a\it*~sedmého Eljóenaje.
\p
\v 4 Obéd‑edóm měl syny: prvorozeného Šemajáše, druhého Józabada, třetího Jóacha, čtvrtého Sakara, pátého Netanela,
\v 5 šestého Amíela, sedmého Isachara, osmého Peúltaje, neboť mu Bůh požehnal.
\p
\v 6 Jeho synu Šemajášovi se narodili synové vládnoucí v~domě svého otce, neboť \it to\it* byli udatní hrdinové.
\v 7 Synové Šemajášovi: Otní, Refaúl, Obéd \it a\it*~Elzabad; jeho bratři Elíhú a~Semakjáš \it byli\it* udatní muži.
\v 8 Tito všichni byli ze synů Obéd‑edómových; jejich synové a~bratři \it byli\it* udatní muži, schopni služby, šedesát dva Obéd‑edómovců.
\v 9 Mešelemjáš měl osmnáct synů a~bratrů, udatných mužů.
\p
\v 10 Chosa, ze synů Merarího, měl syny: předáka Šimrího – nebyl sice prvorozený, ale jeho otec jej ustanovil za předáka –
\v 11 druhého Chilkijáše, třetího Tebaljáše, čtvrtého Zekarjáše; všech synů a~bratrů Chosových \it bylo\it* třináct.
\p
\v 12 Těmto skupinám vrátných podle mužů předáků \it byly dány\it* služby jako jejich bratrům, aby sloužili v~Hospodinově domě.
\v 13 Nechali padnout losy podle domu svých otců jak \it pro\it* malé, tak i~velké, pro \it každou\it* bránu.
\p
\v 14 Los \it na\it* Východní \it bránu\it* padl pro Šelemjáše. Když nechali padnout los \it pro\it* jeho syna Zekarjáše, rozumného rádce, jeho los padl \it na\it* Severní \it bránu\it*.
\v 15 Pro Obéd‑edóma \it na\it* Jižní \it bránu\it* a~pro jeho syny \it na\it* sklady;
\v 16 pro Šupíma a~pro Chosu na Západní \it bránu\it* s~branou Šaleket na horní silnici; stráž vedle stráže.
\v 17 Na východě \it bylo\it* šest lévitů, na severu denně čtyři, na jihu denně čtyři, pro sklady po dvou,
\v 18 u~parbaru na západě: čtyři na silnici \it a\it*~dva u~parbaru.
\v 19 Toto \it jsou\it* skupiny vrátných ze synů Kórachových a~ze synů Merarího.
\p
\v 20 Další lévité: Achijáš \it byl\it* nad poklady Božího domu a~nad poklady svatých věcí.
\v 21 Synové Laedánovi: synové Geršónovců patřící Laedánovi, předáci rodů Geršónovce Laedána – Jechíelovci.
\v 22 Synové Jechíelovi: Zétami a~jeho bratr Jóel \it byli\it* nad poklady Hospodinova domu.
\v 23 Z~Amrámců, Jishárců, Chebrónců \it a\it*~Ozíelců
\v 24 \it byl\it* představeným nad poklady Šebúel, syn Geršóma, syna Mojžíšova.
\v 25 Jeho bratři z~Elíezera: jeho syn Rechabjáš, jeho syn Izajáš, jeho syn Jóram, jeho syn Zikrí, jeho syn Šelomít.
\v 26 Tento Šelomít a~jeho bratři \it byli\it* nad všemi poklady svatých věcí, které zasvětil král David, předáci rodů, velitelé \it nad\it* tisíci a~\it nad\it* sty, velitelé armády.
\v 27 \it Něco\it* z~bojů a~kořisti zasvětili na opravu Hospodinova domu.
\v 28 Všechno, co zasvětil vidoucí Samuel, Saul, syn Kíšův, Abnér, syn Nérův, i~Jóab, syn Serújin, všechno, co bylo zasvěcené, \it bylo\it* ve správě Šelomíta a~jeho bratrů.
\p
\v 29 Z~Jishárců: Kenanjáš a~jeho synové \it byli\it* jako správci a~soudci nad Izraelem pro službu mimo \it svatyni\it*.
\v 30 Z~Chebrónců: Chašabjáš a~jeho bratři, tisíc sedm set udatných mužů, \it byli\it* dozorci nad Izraelem na západ od Jordánu pro veškeré dílo Hospodinovo i~pro službu králi.
\v 31 Z~Chebrónců: předák Jerijáš; (co se týče Chebrónců, totiž jejich rodopisu otců: ve čtyřicátém roce Davidova kralování se hledalo a~našli se mezi nimi udatní hrdinové v~gileádském Jaezeru;)
\v 32 jeho bratrů, udatných mužů, \it bylo\it* dva tisíce sedm set předáků rodů. Ty král David ustanovil nad Rúbenovci, Gádovci a~polovinou kmene Manasesova pro všechny záležitosti Boží i~záležitosti královy.
\c 27
\s1 Dvanáct velitelů
\p
\v 1 Synové Izraele podle jejich výčtu, předáci rodů, velitelé \it nad\it* tisíci a~\it nad\it* sty a~jejich správci, kteří sloužili králi ve všech věcech skupin, přicházející a~vycházející měsíc co měsíc, po všechny měsíce roku; jeden oddíl \it měl\it* dvacet čtyři tisíc.
\p
\v 2 Nad prvním oddílem v~prvním měsíci \it byl\it* Jášobeám, syn Zabdíelův; jeho oddíl \it měl\it* dvacet čtyři tisíce.
\v 3 \it Byl\it* ze synů Peresových, předákem nad všemi veliteli armády v~prvním měsíci.
\p
\v 4 Nad oddílem druhého měsíce \it byl\it* Dódaj Achóchijský; Miklót \it byl\it* vévodou jeho oddílu; jeho oddíl \it měl\it* dvacet čtyři tisíce.
\p
\v 5 Třetím velitelem armády v~třetím měsíci \it byl\it* Benajáš, syn vrchního kněze Jójady; jeho oddíl \it měl\it* dvacet čtyři tisíce.
\v 6 To \it je ten\it* Benajáš, hrdina \it mezi\it* třiceti a~nad třiceti; \it nad\it* jeho oddílem \it byl\it* jeho syn Amízábad.
\p
\v 7 Čtvrtý ve čtvrtém měsíci \it byl\it* Asáel, bratr Jóabův, a~po něm jeho syn Zebadjáš; jeho oddíl \it měl\it* dvacet čtyři tisíce.
\p
\v 8 Pátý v~pátém měsíci \it byl\it* Šamhút Jizrachejský; jeho oddíl \it měl\it* dvacet čtyři tisíce.
\p
\v 9 Šestý v~šestém měsíci \it byl\it* Íra, syn Íkeše Tekójského; jeho oddíl \it měl\it* dvacet čtyři tisíce.
\p
\v 10 Sedmý v~sedmém měsíci \it byl\it* Cheles Pelónský ze synů Efrajimových; jeho oddíl \it měl\it* dvacet čtyři tisíce.
\p
\v 11 Osmý v~osmém měsíci \it byl\it* Sibekaj Chúšatský ze Zerachejců; jeho oddíl \it měl\it* dvacet čtyři tisíce.
\p
\v 12 Devátý v~devátém měsíci \it byl\it* Abíezer Anatótský z~Benjamínovců; jeho oddíl \it měl\it* dvacet čtyři tisíce.
\p
\v 13 Desátý v~desátém měsíci \it byl\it* Mahraj Netófský ze Zerachejců; jeho oddíl \it měl\it* dvacet čtyři tisíce.
\p
\v 14 Jedenáctý v~jedenáctém měsíci \it byl\it* Benajáš Pireatónský ze synů Efrajimových; jeho oddíl \it měl\it* dvacet čtyři tisíce.
\p
\v 15 Dvanáctý ve dvanáctém měsíci \it byl\it* Cheldaj Netófský z~Otníela; jeho oddíl \it měl\it* dvacet čtyři tisíce.
\s1 Velitelé kmenů
\p
\v 16 Nad izraelskými kmeny \it byli\it*: nad Rúbenovci \it byl\it* vévodou Elíezer, syn Zikrího; nad Šimeónovci Šefatjáš, syn Maakův;
\p
\v 17 nad Lévijci Chašabjáš, syn Kemúelův; nad Áronem Sádok;
\p
\v 18 nad Judou Elíhú z~Davidových bratrů; nad Isacharem Omrí, syn Michaelův;
\p
\v 19 nad Zabulónem Jišmajáš, syn Obadjášův; nad Neftalím Jerímót, syn Azríelův;
\p
\v 20 nad syny Efrajimovými Hóšea, syn Azazjášův; nad polovinou kmene Manasesova Jóel, syn Pedajášův;
\p
\v 21 nad polovinou Manasesa v~Gileádu Jidó, syn Zekarjášův; nad Benjamínem Jaasíel, syn Abnérův;
\p
\v 22 nad Danem Azarel, syn Jerochámův. Toto \it jsou\it* velitelé izraelských kmenů.
\p
\v 23 David neuvedl počet dvacetiletých a~mladších, neboť Hospodin řekl, že rozmnoží Izrael jako nebeské hvězdy.
\v 24 Jóab, syn Serújin, začal sčítat, ale nedokončil \it to\it*, neboť kvůli tomu dopadlo na Izrael rozhořčení. A~tak se počet nedostal do knihy Letopisů krále Davida.
\s1 Královi služebníci
\p
\v 25 Nad královskými sklady \it byl\it* Azmávet, syn Adíelův. Nad sklady v~zemi – ve městech, na vesnicích a~ve věžích – \it byl\it* Jónatan, syn Uzijášův.
\p
\v 26 Nad venkovskými dělníky pro polní práci \it byl\it* Ezrí, syn Kelúbův.
\p
\v 27 Nad vinicemi \it byl\it* Šimeí Rámatský; nad sklady vína, které \it jsou\it* na vinicích, \it byl\it* Zabdí Šifmejský.
\p
\v 28 Nad olivovými háji a~sykomorami, které \it jsou\it* v~Šefele, \it byl\it* Baal‑chanan Gederský. Nad sklady oleje \it byl\it* Jóaš.
\p
\v 29 Nad skotem pasoucím se v~Šáronu \it byl\it* Šitraj Šáronský. Nad skotem v~údolích \it byl\it* Šafat, syn Adlajův.
\p
\v 30 Nad velbloudy \it byl\it* Izmaelita Obíl. Nad oslicemi \it byl\it* Jechdejáš Meronótský.
\p
\v 31 Nad ovcemi \it byl\it* Hagrejec Jazíz. Všichni tito \it byli\it* předáky \it nad\it* majetkem, který patřil králi Davidovi.
\p
\v 32 Jónatan, Davidův strýc, zkušený \it to\it* člověk, byl rádcem a~písařem. Jechíel, syn Chachmóního, \it byl\it* s~královskými syny.
\v 33 Achítofel \it byl\it* královým rádcem. Chúšaj Arkijský \it byl\it* královým přítelem.
\v 34 Po Achítofelovi \it byl\it* Jójada, syn Benajášův, a~Ebjátar. Velitelem královy armády \it byl\it* Jóab.
\c 28
\s1 Davidovy plány
\p
\v 1 David shromáždil do Jeruzaléma všechny izraelské velitele, velitele kmenů, velitele oddílů, kteří sloužili králi, velitele \it nad\it* tisíci a~velitele \it nad\it* sty, předáky \it nad\it* vším majetkem a~dobytkem krále a~jeho synů, spolu s~dvorními úředníky, hrdiny, všechny zámožné lidi.
\v 2 Král David se postavil na nohy a~řekl: Slyšte mě, mí bratři a~můj lide! \it Měl jsem\it* na srdci postavit dům odpočinutí pro truhlu Hospodinovy smlouvy, pro podnož nohou našeho Boha, a~udělal jsem přípravy ke stavbě.
\v 3 Bůh však mi řekl: Nestav dům pro mé jméno, neboť jsi bojovník a~prolil jsi \it mnoho\it* krve.
\v 4 Hospodin, Bůh Izraele, si mě vyvolil z~celého domu mého otce, abych byl navěky králem nad Izraelem. Vždyť Judu si vyvolil za vévodu a~v~domě Judově dům mého otce a~mezi syny mého otce si oblíbil mě, aby \it mě\it* ustanovil králem nad celým Izraelem.
\p
\v 5 Ze všech synů – a~Hospodin mi dal mnoho synů – si vyvolil mého syna Šalomouna, aby seděl na trůnu Hospodinova království nad Izraelem.
\v 6 Řekl mi: Tvůj syn Šalomoun, ten postaví můj dům a~má nádvoří, neboť jeho jsem si vyvolil za syna a~já budu jeho otcem.
\v 7 Jeho království upevním navěky, jestliže bude pevný \it v~tom\it*, aby plnil mé příkazy a~má nařízení jako dnes.
\p
\v 8 Nyní před očima celého Izraele, Hospodinova shromáždění, a~před naším Bohem \it říkám\it*: Zachovávejte a~vyhledávejte všechny příkazy Hospodina, svého Boha, abyste zdědili tu dobrou zemi a~dali \it ji do\it* dědictví svým synům po vás navěky.
\p
\v 9 A~ty, můj synu Šalomoune, poznávej Boha svého otce a~služ mu celým srdcem a~ochotnou duší, neboť Hospodin zkoumá každé srdce a~zná každé zaměření myšlenek. Budeš‑li jej hledat, dá se ti nalézt, opustíš‑li ho, natrvalo tě odvrhne.
\v 10 Nuže pohleď, že si tě Hospodin vyvolil, abys postavil dům pro svatyni. Posilni se a~jednej.
\p
\v 11 David dal svému synu Šalomounovi plán předsíně, jeho budov, jeho pokladnic, jeho horních místností, jeho vnitřních pokojů a~domu pro slitovnici,
\v 12 plán všeho, co měl na mysli: nádvoří Hospodinova domu, všechny okolní komory, pokladnice Božího domu a~pokladnice svatých věcí,
\v 13 oddíly kněží a~lévitů, všechnu práci služby Hospodinova domu a~všechny předměty služby Hospodinova domu.
\v 14 \it Též\it* váhu zlata na všechny zlaté předměty každé \it boho\it*služby, váhu pro všechny stříbrné předměty \it a\it*~pro všechny předměty každé \it boho\it*služby,
\v 15 váhu \it zlata\it* na zlaté svícny a~jejich zlaté lampy s~váhou \it pro\it* každý svícen a~jeho lampy i~na stříbrné svícny s~váhou pro svícen a~jeho lampy podle služby každého svícnu,
\v 16 váhu zlata na stoly \it pro\it* předkladné \it chleby\it* pro každý stůl, stříbra na stříbrné stoly,
\v 17 \it na\it* vidlice, misky a~konve \it z\it*~čistého zlata, váhu zlatých pohárů pro každý pohár a~váhu stříbrných pohárů pro každý pohár,
\v 18 váhu přečištěného zlata na kadidlový oltář a~zlato pro napodobeninu vozu cherubů s~roztaženými \it křídly\it*, zastírajícími truhlu Hospodinovy smlouvy.
\v 19 To všechno \it bylo\it* písemně, protože Hospodinova ruka \it byla\it* nade mnou; \it on mi\it* dal pochopit plán celého díla.
\p
\v 20 David řekl svému synu Šalomounovi: Posilni se, buď odvážný a~jednej. Neboj se a~neděs se, neboť Hospodin Bůh, můj Bůh, \it je\it* s~tebou. Nenechá tě klesnout a~neopustí tě, dokud nedokončíš všechnu práci \it pro\it* službu Hospodinova domu.
\v 21 Zde \it jsou\it* oddíly kněží a~lévitů pro každou službu Božího domu; \it budou\it* s~tebou při každé práci, ke všemu ochotní \it a\it*~moudří, ke každé službě, a~také předáci a~všechen lid pro každý tvůj záměr.
\c 29
\s1 Dary pro chrám
\p
\v 1 Nato král David řekl celému shromáždění: Můj syn Šalomoun, jehož jediného vyvolil Bůh, \it je\it* mladý a~útlý a~dílo \it je\it* veliké, neboť to není hrad pro člověka, ale pro Hospodina Boha.
\v 2 Ze vší své síly jsem připravil pro dům svého Boha zlato na \it věci\it* zlaté, stříbro na stříbrné, bronz na bronzové, železo na železné, dřevo na dřevěné, kameny karneolové a~pro vsazování kameny antimonové a~pestrobarevné, všelijaké drahokamy i~množství mramoru.
\v 3 Navíc, protože jsem si oblíbil dům svého Boha, z~osobního vlastnictví zlata a~stříbra jsem dal pro dům svého Boha kromě všeho, co jsem připravil pro dům svatyně:
\v 4 tři tisíce talentů zlata, zlata \it z\it*~Ofíru, sedm tisíc talentů přečištěného stříbra pro potažení stěn domů,
\v 5 zlato na \it věci\it* zlaté, stříbro na stříbrné a~pro všechnu práci konanou řemeslníky. Kdo se dnes dobrovolně rozhodne otevřít ruku pro Hospodina?
\p
\v 6 Dobrovolně se rozhodli předáci rodů, velitelé izraelských kmenů, velitelé \it nad\it* tisíci a~\it nad\it* sty a~předáci \it nad\it* prací \it pro\it* krále.
\v 7 Pro službu Božího domu dali pět tisíc talentů zlata a~deset tisíc darejků, deset tisíc talentů stříbra, osmnáct tisíc talentů bronzu a~sto tisíc talentů železa.
\v 8 Ten, kdo měl \it draho\it*kamy, dal \it je\it* do pokladu Hospodinova domu do správy Geršónovce Jechíela.
\p
\v 9 Lid se radoval z~jejich dobrovolného rozhodnutí, neboť se rozhodli \it dát\it* Hospodinu dobrovolně \it a\it*~z~celého srdce; také král David se převelice radoval.
\s1 Davidova modlitba
\p
\v 10 Nato David dobrořečil Hospodinu před zraky celého shromáždění. David řekl: Požehnaný buď, Hospodine, Bože Izraele, našeho otce, od věků až navěky.
\v 11 Tobě, Hospodine, patří velikost, udatnost, sláva, síla i~nádhera, ano, všechno, \it co je\it* na nebesích i~na zemi. Tobě, Hospodine, patří království, vyvýšený jsi jako hlava nade všechno.
\v 12 Bohatství i~sláva \it jsou\it* od tebe, ty vládneš nade vším, ve tvé ruce \it je\it* síla a~udatnost, ve tvé ruce \it je\it* učinit velkým a~posílit každého.
\p
\v 13 Nyní, Bože náš, ti vzdáváme díky a~chválíme tvé slavné jméno.
\v 14 Vždyť kdo \it jsem\it* já a~kdo \it je\it* můj lid, že bychom byli schopni se \it k\it*~něčemu takovému dobrovolně rozhodnout? Vždyť od tebe \it je\it* všechno a~ze tvé ruky jsme ti dali.
\v 15 Vždyť jsme před tebou hosté a~příchozí jako všichni naši otcové; jako stín \it jsou\it* naše dny na zemi, není naděje.
\v 16 Hospodine, Bože náš, celé toto bohatství, které jsme připravili, abychom ti postavili dům pro tvé svaté jméno, je z tvé ruky, to všechno ti patří.
\p
\v 17 Vím, můj Bože, že ty zkoumáš srdce a~oblibuješ přímost. V~přímosti svého srdce jsem se rozhodl dobrovolně \it dát\it* toto všechno a~nyní jsem s~radostí viděl, \it že i\it*~tvůj lid, který je zde, se rozhodl \it dát to\it* pro tebe dobrovolně.
\p
\v 18 Hospodine, Bože Abrahama, Izáka a~Izraele, našich otců, zachovej to navěky jako zaměření myšlenek srdce svého lidu a~zaměř jejich srdce k~sobě.
\v 19 A~mému synu Šalomounovi dej neporušené srdce, aby zachovával tvé příkazy, tvá svědectví a~ustanovení, plnil to všechno a~postavil ten hrad, \it pro\it* který jsem udělal přípravy.
\p
\v 20 Potom David řekl celému shromáždění: Dobrořečte Hospodinu, svému Bohu. Celé shromáždění tedy dobrořečilo Hospodinu, Bohu svých otců, poklekali a~klaněli se Hospodinu a~králi.
\p
\v 21 Druhý den Hospodinu obětovali obětní hody a~přinášeli mu zápalné oběti – tisíc býčků, tisíc beranů \it a\it*~tisíc beránků; též jejich litých obětí a~obětních hodů \it bylo\it* množství za celý Izrael.
\v 22 V~onen den jedli a~pili před Hospodinem s~velikou radostí. Potom ustanovili podruhé Šalomouna, syna Davidova, králem a~pomazali \it jej\it* Hospodinu za vévodu a~Sádoka za kněze.
\p
\v 23 Šalomoun seděl na Hospodinově trůnu jako král po svém otci Davidovi, dařilo se \it mu\it* a~celý Izrael ho poslouchal.
\v 24 Všichni předáci, hrdinové i~všichni synové krále Davida se poddali králi Šalomounovi.
\v 25 Hospodin učinil Šalomouna velmi velkým v~očích celého Izraele a~dal mu královský majestát, jaký před ním neměl žádný král nad Izraelem.
\s1 David umírá
\p
\v 26 David, syn Jišajův, kraloval nad celým Izraelem.
\v 27 Doba, po kterou kraloval nad Izraelem, \it byla\it* čtyřicet let. V~Chebrónu kraloval sedm let a~v~Jeruzalémě kraloval třicet tři \it let\it*.
\v 28 I~zemřel v~utěšených šedinách, sytý dnů, bohatství a~slávy. Po něm se stal králem jeho syn Šalomoun.
\v 29 První i~poslední činy krále Davida jsou zapsány v~letopisech vidoucího Samuela, v~letopisech proroka Nátana a~v~letopisech vidoucího Gáda,
\v 30 spolu se všemi jeho královskými a~udatnými \it činy\it* a~\it událostmi\it* té doby, které postihly jej, Izrael a~všechna království \it okolních\it* zemí.
\p
