\id SNG
\c 1
\q1
\v 1 Píseň písní. Šalomounova.
\s1 Namlouvání
\q1
\v 2 \it Kéž\it* v~polibcích mě ústy svými zlíbá!
\q2 Nad víno lepší \it je\it* tvé milování.
\q1
\v 3 Vzácné tvé oleje tak voní!
\q2 Tvé jméno \it je\it* esence aromatická.
\q2 Proto dívky tě milují.
\q1
\v 4 Vtáhni mě za sebou, pojďme honem!
\q2 \it Už\it* mne král uvedl \it do\it* komnat \it u\it*~sebe!
\q2 Výskejme, radost mějme z~tebe.
\q2 Oslavíme lásku tvou, a~ne vínem.
\q2 \it Zcela\it* právem tě milují.
\q1
\v 5 Jsem černá, ale krásná,
\q2 \it vy\it* dcery \it v\it*~Jeruzalémě,
\q2 jak stany kédarského \it kmene,\it*
\q2 jak závěsy \it ve stanu\it* Šalomouna.
\q1
\v 6 Nehleďte \it na\it* mne, že jsem osmahlá,
\q2 že slunce \it tak\it* opálilo mne.
\q2 Proti mně vzpláli mé matky synové,
\q2 postavili mne, ať vinohrady hlídám.
\q2 Vlastní vinohrad jsem neuhlídala.
\q1
\v 7 Miláčku můj, pověz, kde \it je\it* tvá pastvina,
\q2 kde přes poledne dáváš ležet \it stádu?\it*
\q2 Vždyť proč mám stát jak zastřená
\q2 před stády tvých kamarádů?
\q1
\v 8 Když \it to\it* nevíš sama,
\q2 ženo \it mnoha\it* krás,
\q2 vyjdi si po stopách stáda
\q2 a~kozičky své pas
\q2 před příbytky pastevců.
\q1
\v 9 Jako klisna mezi hřebci faraona
\q2 připadáš mi, lásko má.
\q1
\v 10 \it Po\it* líci se ti vinou pramínky,
\q2 korále tvou šíji \it vroubí.\it*
\q1
\v 11 Pramínky zlaté uděláme ti,
\q2 v~\it nich\it* stříbro \it jako\it* kapičky.
\q1
\v 12 Dokud král u~sebe \it si hoví,\it*
\q2 můj nard vůni vydává.
\q1
\v 13 Voničkou myrhy \it je\it* mi můj milý,
\q2 v~mých prsech \it když\it* spočívá.
\q1
\v 14 Keříkem henny \it je\it* mi můj milý
\q2 na vinicích \it v\it*~Én‑gedí.
\q1
\v 15 Jak jsi krásná, lásko má,
\q2 jak jsi krásná.
\q2 Oči máš \it jako\it* holoubky.
\q1
\v 16 Jak jsi krásný, můj milý, jak hezounký \it jsi!\it*
\q2 Naše lože \it prostírá se v\it*~zeleni.
\q1
\v 17 Dům náš cedrové \it má\it* trámy,
\q2 vazník cypřišový.
\c 2
\q1
\v 1 \it A\it*~já – šáronský kvítek,
\q2 lilie údolní.
\q1
\v 2 Pak tedy lilie mezi bodláky,
\q2 to \it je\it* má láska mezi dívkami.
\q1
\v 3 Pak tedy jabloň v~lese mezi stromy,
\q2 to \it je\it* můj milý mezi mládenci.
\q2 Po jeho stínu jsem zatoužila.
\q2 Sedím a~\it na\it* jeho sladkém ovoci
\q2 pochutnávám si.
\q1
\v 4 Zaveďte mne, kde víno dávají,
\q2 a~podávejte mi lásku.
\q1
\v 5 Oživte mne hrozinkovými koláči,
\q2 z~jablek mi dodejte sílu,
\q2 neboť jsem láskou nemocná.
\q1
\v 6 Hlavou mu na levici ležím,
\q2 svou pravicí mne objímá.
\q1
\v 7 Zapřísahám vás, dcery Jeruzaléma,
\q2 při plachých gazelách a~laních,
\q2 ať nebudíte, neprobouzíte lásku,
\q2 dokud nebude chtít.
\s1 Poznávání
\q1
\v 8 Slyš! \it To je\it* můj milý!
\q2 Hleďte, už jde!
\q2 \it Už\it* skáče přes hory,
\q2 přeskakuje kopce.
\q1
\v 9 Jako srnec je můj milý,
\q2 jak samec gazely.
\q2 Hleďte, už stojí \it u\it*~nás za zdí,
\q2 do okének nahlíží, mřížkami hledí.
\q1
\v 10 Ozval se můj milý,
\q2 \it toto\it* mi praví:
\q2 Vstávej, má lásko,
\q2 pojď, \it ty\it* má krásko.
\q1
\v 11 Vždyť skončila \it už\it* zima,
\q2 pominuly deště, jsou ty tam.
\q1
\v 12 Květinky z~půdy prokvétají,
\q2 přišel čas \it révu\it* prořezat,
\q2 hrdliččin hlas je slyšet po kraji.
\q1
\v 13 Na fíkovníku dozrávají fíky první,
\q2 réví \it už\it* rozkvétá, vydává vůni.
\q2 Vstávej, má lásko,
\q2 pojď, \it ty\it* má krásko.
\q1
\v 14 Holoubku můj ve skále schovaný,
\q2 ukrytý na srázu u~stěny,
\q2 jak vypadáš, ukaž se mi,
\q2 ať slyším tvůj hlas!
\q2 Vždyť hlas tvůj \it tak\it* libě \it zní\it*
\q2 a~pohled \it na\it* tebe \it je plný\it* krás.
\q1
\v 15 Pochytejte nám lišky,
\q2 lištičky, \it co na\it* vinicích škodí.
\q2 Vždyť naše vinice rozkvétá.
\q1
\v 16 Můj milý \it je\it* můj
\q2 a~já jeho.
\q2 V~liliích se pase.
\q1
\v 17 Než zavane den a~prchnou stíny,
\q2 ukaž se, můj milý,
\q2 buď jako srnec,
\q2 jak samec gazely
\q2 na horách \it mezi\it* vrcholy.
\c 3
\q1
\v 1 Miláčka svého jsem hledala
\q2 \it celou\it* noc na loži.
\q2 Hledala jsem, a~nenašla.
\q1
\v 2 Musím vstát a~město obejít,
\q2 po ulicích a~po náměstích
\q2 svého hledat miláčka.
\q2 Hledala jsem, a~nenašla.
\q1
\v 3 Našli mne strážci, kteří město obcházejí.
\q2 – Miláčka mého,
\q2 \it ne\it*viděli jste \it ho?\it*
\q1
\v 4 Sotva jsem od nich poodešla,
\q2 už jsem miláčka svého našla.
\q2 Držím ho a~nepustím,
\q2 dokud ho nepřivedu k~matičce své domů,
\q2 do maminčina pokoje.
\q1
\v 5 Zapřísahám vás, dcery Jeruzaléma,
\q2 při plachých gazelách a~laních,
\q2 ať nebudíte, neprobouzíte lásku,
\q2 dokud nebude chtít.
\s1 Svatba
\q1
\v 6 Kdo \it je\it* ta, jež z~pouště stoupá
\q2 jako sloup dýmu, myrhou provoněná
\q2 i~kadidlem z~dovážených koření?
\q1
\v 7 Hle, nosítka \it samého\it* Šalomouna!
\q2 Šedesát hrdinů okolo nich
\q2 z~Izraele nejudatnějších.
\q1
\v 8 Mečem vládnou všichni, \it v\it*~boji zkušení,
\q2 každý se mečem opásal,
\q2 ani noc je \it ne\it*zaskočí.
\q1
\v 9 Nosítka pořídil si Šalomoun král
\q2 ze dřeva z~Libanonu.
\q1
\v 10 Sloupky jim \it ze\it* stříbra udělal,
\q2 \it ze\it* zlata oporu trůnu,
\q2 sedadlo purpurové.
\q2 Láskou jsou uvnitř vystlána
\q2 od dívek \it z\it*~Jeruzaléma.
\q1
\v 11 Pojďte ven pohledět,
\q2 \it vy\it* dcerky Sijónu,
\q2 na krále Šalomouna,
\q2 na \it jeho\it* korunu,
\q2 již mu jeho matka nasadila
\q2 v~den svatby jeho,
\q2 v~den, \it kdy\it* mu srdce plesalo.
\c 4
\q1
\v 1 Jak jsi krásná, lásko má,
\q2 jak jsi krásná.
\q2 Oči máš \it jako\it* holoubky,
\q2 \it když\it* zpod závoje \it hledí.\it*
\q2 Vlasy tvé co \it ve\it* stádu kozičky
\q2 z~pohoří Gileád sbíhají.
\q1
\v 2 Tvé zuby – ovečky \it čerstvě umyté,\it*
\q2 když stádo ke střiži stoupá z~koupele.
\q2 Každá \it z\it*~nich po dvou rodí
\q2 a~neplodné mezi nimi není.
\q1
\v 3 Karmínová stuha \it jsou\it* tvé rty,
\q2 tvá ústa nádherná.
\q2 Jak \it z\it*~rozpuklého jablka granáty
\q2 zpod závoje skráň \it hledí\it* tvá.
\q1
\v 4 Jako věž Davidova
\q2 je tvá šíje ztepilá.
\q2 \it Na\it* tisíc zavěšeno na ní štítů,
\q2 výstroj samých to hrdinů.
\q1
\v 5 Dva koloušci \it je\it* dvojice prsů tvých,
\q2 dvojčátka gazelí, jež pasou se v~liliích.
\q1
\v 6 Než zavane den a~prchnou stíny,
\q2 vyjdu si k~té hoře myrhy,
\q2 k~pahorku vonných pryskyřic.
\q1
\v 7 Celá jsi krásná, lásko má,
\q2 není na tobě poskvrna.
\q1
\v 8 Nevěsto, se mnou z~Libanonu,
\q2 se mnou z~Libanonu sestup dolů.
\q2 Shlédneš z~vrcholu Amány,
\q2 z~vrcholu Seníru a~Chermónu,
\q2 ze lvích doupat, z~hor leopardů.
\q1
\v 9 Srdce jsi mi odjala, nevěsto má nejdražší,
\q2 srdce jsi mi odjala očkem svým jediným,
\q2 zákrutem jediným svého náhrdelníku.
\q1
\v 10 Jak je krásné milování tvé,
\q2 nevěsto má nejdražší,
\q2 oč lepší je nad víno tvé milování.
\q2 Nade všechny balzámy tvé oleje voní.
\q1
\v 11 Tvé rty, nevěsto, medem kanou,
\q2 mléko a~med máš pod jazykem,
\q2 roucho tvé vůní Libanonu voní.
\q1
\v 12 Zahrada zavřená \it jsi,\it*
\q2 nevěsto má nejdražší,
\q2 valem zahrazená,
\q2 pramen zapečetěný.
\q1
\v 13 Tvé údy \it královská je\it* obora,
\q2 granátovníky s~lahodným ovocem,
\q2 hennou a~nardem,
\q1
\v 14 nardem a~šafránem,
\q2 citronelou a~skořicí,
\q2 k~tomu všemožné vonné dřeviny,
\q2 myrha i~aloe
\q2 a~ty nejvzácnější balzámy.
\q1
\v 15 Pramenem zahrad \it jsi,\it*
\q2 studnou vody živé,
\q2 \it až\it* z~Libanonu tekoucí.
\q1
\v 16 Zvedni se, \it od\it* severu \it větře\it*, přijď, \it větře od\it* jihu,
\q2 prověj mou zahrádku,
\q2 ať vlastní vůní orosí se.
\q2 Ať do své zahrady přijde můj milý
\q2 a~její ovoce lahodné okusí.
\c 5
\q1
\v 1 Do své přišel jsem zahrady,
\q2 nevěsto má nejdražší.
\q2 Svou myrhu i~své balzámy
\q2 natrhal jsem,
\q2 \it ze\it* své plástve se svým medem
\q2 pojedl jsem,
\q2 víno své i~se svým mlékem
\q2 popíjel jsem.
\q2 \it Jen\it* jezte, milí, pijte,
\q2 opojte se milováním.
\s1 Slasti a~strasti
\q1
\v 2 Spím. Mé srdce ale bdí.
\q2 Slyš! \it To\it* klepe můj milý!
\q2 Otevři mi, má lásko nejdražší,
\q2 holoubku můj, zlato mé!
\q2 Vždyť hlavu mám plnou rosy,
\q2 krůpějí noci své kadeře.
\q1
\v 3 Svlékla jsem si šaty,
\q2 \it mám\it* je zase oblékat?
\q2 Umyla jsem si nohy,
\q2 to si je \it mám\it* špinit zas?
\q1
\v 4 Můj milý rukou vnikl ke mně,
\q2 až jsem se pro něj \it v\it*~nitru zachvěla.
\q1
\v 5 Já vstala milému svému otevřít
\q2 a~myrha mi \it z\it*~rukou skanula,
\q2 myrha \it z\it*~mých prstů ulpívá
\q2 tam, \it kde\it* zasouvá se závora.
\q1
\v 6 Já svému milému otevřela,
\q2 můj milý však náhle zmizel.
\q2 \it Skoro\it* jsem život vypustila,
\q2 že \it takhle\it* odešel.
\q2 Hledala jsem jej, ale nenašla.
\q2 Volala jsem ho, už se mi neozval.
\q1
\v 7 Našli mne strážci,
\q2 kteří město obcházejí.
\q2 Zbili mě do krve,
\q2 šál strhli ze mne
\q2 ti strážci hradeb.
\q1
\v 8 Zapřísahám vás, dcery Jeruzaléma,
\q2 když mého milého najdete,
\q2 co jemu povíte?
\q2 Že láskou jsem nemocná.
\q1
\v 9 Čím \it je\it* tvůj milý nad jiné,
\q2 ženo \it mnoha\it* krás?
\q2 Čím \it je\it* tvůj milý nad jiné,
\q2 že tak zapřísaháš nás?
\q1
\v 10 Můj milý, jiskrný a~růžolící,
\q2 znát je mezi statisíci.
\q1
\v 11 Hlavu má \it jak z\it*~ryzího zlata,
\q2 černé jak havran kučery jeho kadeří.
\q1
\v 12 Oči jeho nad vodními proudy, holoubata
\q2 v~mléce umytá, nad hojnou vodou sedí.
\q1
\v 13 Jeho líce záhon balzámový osetý kořením,
\q2 \it co\it* lilie rty jeho kanoucí myrhou tekutou.
\q1
\v 14 Ruce má \it jak\it* válce zlaté osázené topazem.
\q2 Jeho břicho vykládané slonovinou
\q2 pokryto je safíry.
\q1
\v 15 Mramorové sloupy jeho stehna,
\q2 na patkách zlata ryzího postaveny.
\q2 Zjevem se Libanonu podobá,
\q2 ušlechtilý jako \it ty\it* cedry.
\q1
\v 16 Jeho ústa \it jsou\it* přesladká
\q2 a~\it ve\it* všem \it je\it* přitažlivý.
\q2 To \it je\it* můj milý a~to \it je\it* můj druh,
\q2 dcery Jeruzaléma.
\c 6
\q1
\v 1 Kampak tvůj milý šel,
\q2 ty ženo \it mnoha\it* krás?
\q2 Kam se tvůj milý poděl,
\q2 ať s~tebou najdeme ho \it zas.\it*
\q1
\v 2 Do zahrádky své
\q2 sestoupil můj milý
\q2 na záhony balzámové,
\q2 v~zahradách se pást,
\q2 lilie nasbírat.
\q1
\v 3 Můj milý má mne,
\q2 můj milý je můj.
\q2 V~liliích se pase.
\q1
\v 4 Krásná jsi, lásko má,
\q2 jako \it město\it* Tirsa,
\q2 jak Jeruzalém nádherná.
\q2 Respekt budíš
\q2 jak nazbrojená armáda.
\q1
\v 5 Odvrať ode mne své oči,
\q2 nebo mne o~rozum připraví.
\q2 Vlasy tvé co \it ve\it* stádu kozičky
\q2 \it dolů\it* z~Gileádu sbíhají.
\q1
\v 6 Tvé zuby – ovečky \it čerstvě umyté,\it*
\q2 když stádo stoupá z~koupele.
\q2 Každá \it z\it*~nich po dvou rodí
\q2 a~není mezi nimi neplodná.
\q1
\v 7 Jak \it z\it*~rozpuklého jablka granáty
\q2 zpod závoje skráň \it hledí\it* tvá.
\q1
\v 8 \it Na\it* šedesát je královen
\q2 a~družek \it na\it* osmdesát
\q2 a~dívek bezpočet,
\q1
\v 9 ona \it je však\it* jediná,
\q2 holoubek můj, zlato mé.
\q2 Ona \it je však\it* jediná
\q2 pro matičku svou,
\q2 pro maminku, \it jež\it* ji \it má\it*
\q2 \it za\it* vyvolenou.
\q2 Jak ji děvčata uzřela,
\q2 zahrnula ji chválou.
\q2 Královny a~družky
\q2 počaly ji velebit:
\q1
\v 10 Kdo \it je\it* ta, jež dolů
\q2 jako úsvit hledí,
\q2 jako luna krásná,
\q2 jako slunce jasná?
\q2 Respekt budí
\q2 jak nazbrojená armáda.
\q1
\v 11 Do sadu sešel jsem \it k\it*~ořeší
\q2 podívat se na zeleň ve vádí,
\q2 podívat se, zda réva vyraší,
\q2 \it zda\it* rozkvetly \it už\it* granáty.
\q1
\v 12 Ne\it ž\it* má duše zvěděla,
\q2 \it na\it* vozy mne stavěla
\q2 lidu mého šlechetného.
\c 7
\q1
\v 1 Tanči, tanči, Šulamít,
\q2 tanči, tanči, chcem tě zřít!
\q2 Co uzříte na Šulamít,
\q2 že \it má v\it*~tanci sólo \it mít?\it*
\q1
\v 2 Jaká je krása tvých kroků
\q2 v~opáncích, dívko \it ty\it* šlechetná!
\q2 Klenotem \it je\it* křivka tvých boků,
\q2 rukama umělce vykroužená.
\q1
\v 3 Tvůj klín se \it jak\it* mísa klene.
\q2 Ať víno mísit nepřestane.
\q2 Tvé bříško pšenice navršená,
\q2 liliemi obroubená.
\q1
\v 4 Dva koloušci
\q2 dvojice prsů tvých,
\q2 dvojčátka gazelí.
\q1
\v 5 Šíje tvá věži ze slonoviny se podobá.
\q2 Tvé oči batrabimskou bránu
\q2 \it zračí jak\it* v~chešbónských nádržích.
\q2 Tvůj nos jako věž Libanonu
\q2 si Damašek prohlíží.
\q1
\v 6 Hlava na tobě jako Karmel \it vyjímá se\it*
\q2 a~\it v~plášti\it* tvých vlasů šarlatovém
\q2 král kvůli \it té\it* kučeravé \it kráse\it*
\q2 zajatcem \it je rázem.\it*
\q1
\v 7 Jak krásná jsi, jak líbezná,
\q2 lásko přerozkošná.
\q1
\v 8 Neseš se tak, že připomínáš palmu
\q2 a~tvé prsy vzdouvají se datlemi.
\q1
\v 9 Chci vylézt na palmu, říkám si,
\q2 datlové trsy popadnu.
\q2 Nebo ať jsou tvé prsy bobulová réva,
\q2 ať po jablkách ti voní dech
\q1
\v 10 a \it v\it*~ústech –
\q2 jako bys to nejlepší víno měla.
\q2 Pro mého milého kane!
\q2 Hladce \it po\it* rtech starců klouzá,
\q1
\v 11 můj milý má mne.
\q2 Po mně \it prahne\it* jeho touha.
\q1
\v 12 Jen pojď, můj milý,
\q2 pojďme ven do polí,
\q2 ať venku přespíme.
\q1
\v 13 Podíváme se ráno na vinice,
\q2 réva jestli vyraší,
\q2 \it zda její\it* květ rozvírá se
\q2 \it a\it*~rozkvetly \it už\it* granáty.
\q2 Tam ti dám své milování.
\q1
\v 14 Laskavec vůni \it už\it* přivání
\q2 a~nad našimi dveřmi
\q2 dozrály lahůdky, nové i~staré.
\q2 Pro tebe, můj milý,
\q2 schovala jsem \it je.\it*
\c 8
\q1
\v 1 Kéž bys byl bratr mé \it rodiny,\it*
\q2 maminkou mou odkojený.
\q2 \it Jak\it* bych tě potkala,
\q2 \it hned\it* bych tě líbala.
\q2 A~\it nikdo\it* by mě nepomluvil.
\q1
\v 2 \it Jak\it* bych se \it s\it*~tebou vodila,
\q2 \it hned\it* bych \it s\it*~tebou zamířila
\q2 k~mámě domů, \it ta\it* mě učívala.
\q2 \it \it*Ukojila bych tě vermutem,
\q2 svých granátů nektarem.
\q1
\v 3 Hlavou mu na levici \it ležím\it*,
\q2 svou pravicí mne objímá.
\q1
\v 4 Zapřísahám vás, dcery Jeruzaléma,
\q2 nač budit, nač probouzet lásku,
\q2 dokud nebude chtít.
\q1
\v 5 Kdo \it je\it* ta, jež stoupá z~pouště,
\q2 o~milého se opírá?
\q2 Pod jabloní probouzela jsem tě,
\q2 tam počala tě matka tvá,
\q2 tam počala \it i\it*~zrodila tě.
\q1
\v 6 Chovej mne jak pečetidlo u~srdce,
\q2 \it měj mě\it* jako pečetítko při ruce.
\q2 Vždyť láska \it je\it* silná jako smrt,
\q2 žárlivost jako záhrobí tvrdá,
\q2 žár její žárem ohně zhrdá.
\q1
\v 7 Tu lásku neuhasí velká voda,
\q2 odplavit ji nedokáže \it dravý\it* proud.
\q2 Byť by kdo za lásku dával vše, co má,
\q2 vypadal by \it jak\it* prostoduchý bloud.
\q1
\v 8 Sestřičku malou máme,
\q2 ani prsa \it ještě\it* nemá.
\q2 Co se sestřičkou uděláme,
\q2 až \it začne\it* být žádaná?
\q1
\v 9 Je‑li hradbou,
\q2 cimbuří stříbrné postavíme na ní.
\q2 Je‑li však bránou,
\q2 deskou cedrovou \it musíme\it* ji zahradit.
\q1
\v 10 Já \it jsem\it* hradba.
\q2 A~prsa mám jako věže.
\q2 Už jsem se pro něj stala
\q2 tou, kterou nepřemůže.
\q2
\q1
\v 11 Vinohrad v~Baal Hamon
\q2 měl Šalomoun.
\q2 Svěřil ten vinohrad správcům,
\q2 za výnos ať \it mu\it* každý
\q2 stříbrných tisíc platí.
\q1
\v 12 Vinice má \it je\it* jenom moje.
\q2 Šalomoune, ten tisíc si nech.
\q2 Dvě stě ať mají \it i\it*~správcové
\q2 na jejích výnosech.
\q1
\v 13 Ty, která přebýváš v~zahradách,
\q2 přátelé naslouchají tvému hlasu.
\q2 Ať slyším \it ho i\it*~já.
\q1
\v 14 Chvátej, můj milý,
\q2 buď jako srnec,
\q2 jak samec gazely
\q2 na horách provoněných.
\q2
